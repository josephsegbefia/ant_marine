<% content_for :title, "Client home — #{Current.membership.organization.name}" %>
<% content_for :client_page_title, "Home" %>
<% content_for :client_nav, "home" %>

<% org = Current.membership.organization %>
<% requests = client_can_view_requests? ? policy_scope(ServiceInquiry).recent_first.limit(5) : ServiceInquiry.none %>
<% releases = client_can_view_quotations? ? Clients::PortalQuoteVisibility.releases_for(membership: Current.membership).limit(5) : QuotePortalRelease.none %>

<div class="client-page-head">
  <h1>Hello, <%= client_greeting_name %>.</h1>
  <p>Here is what is happening for <%= org.name %>.</p>
</div>

<section class="client-welcome-banner">
  <div>
    <p class="public-eyebrow public-eyebrow--on-dark">YOUR MARINE WORK, IN ONE PLACE</p>
    <h2>Welcome to your client portal.</h2>
    <p>View service requests and quotations released for your organisation. Projects, documents and billing will appear here when those tools are ready.</p>
  </div>
</section>

<div class="staff-overview-stats mt-6" aria-label="Your work summary">
  <div class="staff-overview-stat">
    <p class="staff-overview-stat__label">Service requests</p>
    <p class="staff-overview-stat__value"><%= client_can_view_requests? ? policy_scope(ServiceInquiry).count : 0 %></p>
  </div>
  <div class="staff-overview-stat">
    <p class="staff-overview-stat__label">Available quotations</p>
    <p class="staff-overview-stat__value"><%= client_can_view_quotations? ? Clients::PortalQuoteVisibility.releases_for(membership: Current.membership).count : 0 %></p>
  </div>
</div>

<div class="staff-editor-layout mt-6">
  <section class="staff-quote-side-panel">
    <%= render "shared/ui/side_panel_head", title: "Recent service requests", heading_id: "client-home-requests", icon: "clipboard" %>
    <div class="staff-quote-side-panel__body">
      <% if requests.any? %>
        <ul class="staff-quote-versions__list">
          <% requests.each do |inquiry| %>
            <li class="staff-quote-versions__item">
              <div class="staff-quote-versions__head">
                <p class="staff-enquiry-clarification__title"><%= link_to inquiry.reference_number, client_request_path(inquiry), class: "staff-quote-link" %></p>
                <%= ant_status_badge(label: client_request_status_label(inquiry.current_status), badge_class: "ant-badge--muted") %>
              </div>
              <p class="staff-enquiry-row__sub"><%= inquiry.requested_service_label %> · <%= l(inquiry.submitted_at.to_date, format: :long) %></p>
            </li>
          <% end %>
        </ul>
        <p class="mt-3"><%= link_to "All service requests", client_requests_path, class: "staff-quote-link" %></p>
      <% else %>
        <p class="staff-quote-versions__lede">No service requests are linked to your organisation yet. When ANT Marine links a request, it will appear here.</p>
      <% end %>
    </div>
  </section>

  <section class="staff-quote-side-panel">
    <%= render "shared/ui/side_panel_head", title: "Available quotations", heading_id: "client-home-quotes", icon: "file" %>
    <div class="staff-quote-side-panel__body">
      <% if releases.any? %>
        <ul class="staff-quote-versions__list">
          <% releases.each do |release| %>
            <li class="staff-quote-versions__item">
              <div class="staff-quote-versions__head">
                <p class="staff-enquiry-clarification__title"><%= link_to release.quote.reference_number, client_quotation_path(release), class: "staff-quote-link" %></p>
                <% if release.simulated? %>
                  <%= ant_status_badge(label: "Simulated offer", badge_class: "ant-badge--warn") %>
                <% end %>
              </div>
              <p class="staff-enquiry-row__sub">Version <%= release.quote_revision.version_number %> · <%= release.quote_revision.title.presence || "Quotation" %></p>
            </li>
          <% end %>
        </ul>
        <p class="mt-3"><%= link_to "All quotations", client_quotations_path, class: "staff-quote-link" %></p>
      <% else %>
        <p class="staff-quote-versions__lede">No quotations have been released to your portal yet. Draft and unreleased offers stay with ANT Marine.</p>
      <% end %>
    </div>
  </section>
</div>

<section class="staff-quote-side-panel mt-4 max-w-2xl">
  <%= render "shared/ui/side_panel_head", title: "Need help?", heading_id: "client-home-help", icon: "mail" %>
  <div class="staff-quote-side-panel__body">
    <p class="staff-quote-versions__lede">Contact your ANT Marine team through the usual email or phone channels. Simulated test decisions may be available on released quotations for authorised representatives; they are not binding commercial agreements.</p>
    <p class="mt-3"><%= link_to "Account settings", client_account_path, class: "staff-quote-link" %></p>
  </div>
</section>
