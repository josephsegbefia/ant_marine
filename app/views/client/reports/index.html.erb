<% content_for :client_nav, :reports %>

<%= ant_page_header(title: "My reports", description: "Final technical reports your organisation can download.") %>

<% if @reports.any? %>
  <ul class="staff-record-list mt-6">
    <% @reports.each do |report| %>
      <li>
        <%= link_to client_report_path(report), class: "staff-record-list__link" do %>
          <span class="staff-record-list__title"><%= report.title %></span>
          <span class="staff-quote-summary__hint"><%= report.reference_number %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= ant_empty_state(
        title: "No reports shared yet",
        description: "When we release a final report to your organisation, it will appear here."
      ) %>
<% end %>