<% content_for :title, "#{@quote.reference_number} — #{Current.membership.organization.name}" %>
<% content_for :client_page_title, "Quotation" %>
<% content_for :client_nav, "quotations" %>

<div class="portal-shell__back mb-4">
  <%= ant_back_link label: "All quotations", path: client_quotations_path %>
</div>

<div class="client-page-head">
  <h1>Review quotation</h1>
  <p><%= @quote.reference_number %> · Version <%= @revision.version_number %><% if @release.simulated? %> · Simulated offer for testing<% end %></p>
</div>

<% if @release.simulated? %>
  <div class="staff-quote-notice staff-quote-notice--warn mt-4" role="status">
    <p class="font-semibold">This is a simulated offer for portal testing.</p>
    <p class="mt-1 text-sm">Any decision you record here is a test only. It is not a genuine commercial agreement and does not start a project.</p>
  </div>
<% end %>

<% if @terminal %>
  <div class="staff-quote-notice staff-quote-notice--good mt-4" role="status">
    <p class="font-semibold"><%= @terminal.client_status_label %></p>
    <p class="mt-1 text-sm">Recorded <%= l(@terminal.confirmed_at, format: :long) %> by <%= @terminal.responded_by_user.full_name.presence || @terminal.responded_by_user.email %>.</p>
    <% if @terminal.accepted? %>
      <p class="mt-2 text-sm">Quotation accepted. Project setup is the next step — that work belongs to a later release.</p>
    <% end %>
  </div>
<% end %>

<div class="staff-editor-layout mt-6">
  <section class="staff-quote-side-panel">
    <%= render "shared/ui/side_panel_head", title: "Service quotation", heading_id: "client-quote-detail-heading", icon: "file" %>
    <div class="staff-quote-side-panel__body">
      <dl class="staff-quote-summary__list">
        <div><dt>Reference</dt><dd class="staff-quote-summary__ref"><%= @quote.reference_number %></dd></div>
        <div><dt>Version</dt><dd><%= @revision.version_number %></dd></div>
        <div><dt>Prepared for</dt><dd><%= @revision.recipient_lines["company_name"].presence || Current.membership.organization.name %></dd></div>
        <div><dt>Work</dt><dd><%= @revision.title.presence || "—" %></dd></div>
        <div><dt>Currency</dt><dd><%= @revision.currency %></dd></div>
        <div><dt>Total</dt><dd><%= client_money(@revision.total_cents, @revision.currency) %></dd></div>
        <% if @revision.valid_until.present? %>
          <div><dt>Valid until</dt><dd><%= l(@revision.valid_until, format: :long) %></dd></div>
        <% end %>
      </dl>

      <% if @revision.scope_description.present? %>
        <h3 class="mt-5 text-[13px] font-medium text-[#173244]">Scope</h3>
        <p class="mt-2 whitespace-pre-line text-[13px] text-[#3d5a6b]"><%= @revision.scope_description %></p>
      <% end %>
      <% if @revision.deliverables.present? %>
        <h3 class="mt-5 text-[13px] font-medium text-[#173244]">Deliverables</h3>
        <p class="mt-2 whitespace-pre-line text-[13px] text-[#3d5a6b]"><%= @revision.deliverables %></p>
      <% end %>
      <% if @revision.exclusions.present? %>
        <h3 class="mt-5 text-[13px] font-medium text-[#173244]">Exclusions</h3>
        <p class="mt-2 whitespace-pre-line text-[13px] text-[#3d5a6b]"><%= @revision.exclusions %></p>
      <% end %>

      <% if @revision.line_items.any? %>
        <h3 class="mt-5 text-[13px] font-medium text-[#173244]">Line items</h3>
        <div class="staff-enquiry-table-wrap mt-3">
          <table class="staff-enquiry-table">
            <thead>
              <tr>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <% @revision.line_items.each do |line| %>
                <tr>
                  <td><%= line.description %></td>
                  <td><%= line.quantity %></td>
                  <td><%= line.unit %></td>
                  <td><%= client_money(line.line_total_cents, @revision.currency) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @revision.payment_terms.present? %>
        <h3 class="mt-5 text-[13px] font-medium text-[#173244]">Terms</h3>
        <p class="mt-2 whitespace-pre-line text-[13px] text-[#3d5a6b]"><%= @revision.payment_terms %></p>
      <% end %>
    </div>
  </section>

  <aside class="space-y-4">
    <section class="staff-quote-side-panel">
      <%= render "shared/ui/side_panel_head", title: "Your decision", heading_id: "client-quote-decision-heading", icon: "check" %>
      <div class="staff-quote-side-panel__body">
        <% if @terminal %>
          <p class="staff-quote-summary__next-value"><%= @terminal.client_status_label %></p>
          <% if @terminal.reason.present? %>
            <p class="staff-quote-summary__hint mt-2"><%= @terminal.reason %></p>
          <% end %>
        <% elsif @can_accept || @can_decline || @can_request_changes %>
          <p class="staff-quote-versions__lede">Review the exact offer, then choose one action. Simulated decisions are tests only.</p>
          <div class="mt-4 flex flex-col gap-2">
            <% if @can_accept %>
              <%= link_to "Accept quotation", decide_client_quotation_path(@release, type: "accepted"), class: "ant-btn-primary ant-btn-primary--compact" %>
            <% end %>
            <% if @can_request_changes %>
              <%= link_to "Request changes", decide_client_quotation_path(@release, type: "changes_requested"), class: "ant-btn-outline ant-btn-outline--compact" %>
            <% end %>
            <% if @can_decline %>
              <%= link_to "Decline quotation", decide_client_quotation_path(@release, type: "declined"), class: "ant-btn-outline ant-btn-outline--compact" %>
            <% end %>
          </div>
        <% else %>
          <p class="staff-quote-versions__lede">You can view this offer. An authorised representative of your organisation must record the commercial decision.</p>
        <% end %>
      </div>
    </section>

    <section class="staff-quote-side-panel">
      <%= render "shared/ui/side_panel_head", title: "Download", heading_id: "client-quote-pdf-heading", icon: "download" %>
      <div class="staff-quote-side-panel__body">
        <p class="staff-quote-versions__lede">Download the exact released version as a PDF.</p>
        <%= link_to "Download PDF", pdf_client_quotation_path(@release), class: "ant-btn-primary ant-btn-primary--compact mt-4", target: "_blank", rel: "noopener" %>
      </div>
    </section>

    <% if @responses.any? %>
      <section class="staff-quote-side-panel">
        <%= render "shared/ui/side_panel_head", title: "Decision history", heading_id: "client-quote-history-heading", icon: "clock" %>
        <div class="staff-quote-side-panel__body">
          <ul class="staff-quote-versions__list">
            <% @responses.each do |response| %>
              <li class="staff-quote-versions__item">
                <div class="staff-quote-versions__head">
                  <p class="staff-enquiry-clarification__title"><%= response.client_status_label %></p>
                </div>
                <p class="staff-enquiry-row__sub"><%= l(response.confirmed_at, format: :short) %> · Version <%= response.quote_revision.version_number %></p>
                <% if response.reason.present? %>
                  <p class="staff-quote-summary__hint mt-1"><%= response.reason %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>
  </aside>
</div>
