<% content_for :client_nav, :billing %>
<%= ant_page_header(
      eyebrow: @invoice.reference_number,
      title: @invoice.description.presence || "Invoice",
      description: "Issued #{@invoice.issue_on} · Due #{@invoice.due_on}",
      primary_action: (policy(@invoice).download? ? { label: "Download bill", path: download_client_invoice_path(@invoice) } : nil),
      secondary_action: { label: "All bills", path: client_invoices_path }
    ) %>

<div class="staff-quote-notice staff-quote-notice--warn mt-4">
  <p><strong>SIMULATED — NOT PAYABLE.</strong> This bill is for testing only.</p>
</div>

<section class="staff-quote-side-panel mt-6">
  <%= render "shared/ui/side_panel_head", title: "Bill summary", heading_id: "client-invoice-summary", icon: "file",
        badge_label: invoice_payment_display_label(@invoice),
        badge_class: invoice_payment_badge_variant(@invoice) %>
  <div class="staff-quote-side-panel__body">
    <dl class="staff-enquiry-facts">
      <div><dt>Total</dt><dd><%= @invoice.display_total %></dd></div>
      <div><dt>Outstanding</dt><dd><%= @invoice.display_outstanding %></dd></div>
      <div><dt>Project</dt><dd><%= @invoice.project.reference_number %></dd></div>
      <div><dt>Quotation</dt><dd><%= @invoice.quote.reference_number %></dd></div>
    </dl>
    <ul class="staff-quote-versions__list mt-4">
      <% @invoice.invoice_line_items.each do |line| %>
        <li class="staff-quote-versions__item">
          <div class="staff-quote-versions__head">
            <p class="staff-enquiry-clarification__title"><%= line.description %></p>
            <p class="staff-enquiry-row__sub"><%= line.display_line_total %></p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<section class="staff-quote-side-panel mt-4">
  <%= render "shared/ui/side_panel_head", title: "Payments recorded", heading_id: "client-invoice-payments", icon: "check" %>
  <div class="staff-quote-side-panel__body">
    <% visible_payments = @payments.reject { |p| p.internal_note.present? && false } %>
    <% if @payments.any? %>
      <ul class="staff-quote-versions__list">
        <% @payments.each do |payment| %>
          <li class="staff-quote-versions__item">
            <div class="staff-quote-versions__head">
              <p class="staff-enquiry-clarification__title"><%= payment.display_amount %></p>
              <%= ant_status_badge(label: (payment.reversed? ? "Reversed" : "Recorded"), badge_class: (payment.reversed? ? "ant-badge--warn" : "ant-badge--good")) %>
            </div>
            <p class="staff-enquiry-row__sub"><%= l(payment.payment_on) %> · <%= payment.payment_method_label %></p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="staff-quote-versions__lede">No payments have been recorded against this bill yet.</p>
    <% end %>
  </div>
</section>
