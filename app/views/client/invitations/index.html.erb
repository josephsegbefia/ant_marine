<% content_for :title, "Team invitations — #{@organization.name}" %>

<div class="portal-shell">
  <nav class="portal-topnav" aria-label="Client">
    <%= link_to "Client workspace", client_root_path %>
    <span aria-hidden="true">/</span>
    <span>Team invitations</span>
  </nav>

  <header class="portal-head">
    <div>
      <h1>Team invitations</h1>
      <p>Invite colleagues to <%= @organization.name %> and manage pending invitations for your organisation.</p>
    </div>
  </header>

  <%= render "shared/auth_flash" %>

  <div class="portal-split">
    <section class="portal-card">
      <h3>Recent invitations</h3>
      <%= render "shared/invitations/list",
            invitations: @invitations,
            show_organization: false,
            cancel_path: ->(invitation) { client_invitation_path(invitation) },
            resend_path: ->(invitation) { resend_client_invitation_path(invitation) } %>
    </section>

    <section class="portal-card">
      <h3>Invite a colleague</h3>
      <%= form_with url: client_invitations_path, class: "mt-5" do |form| %>
        <div class="portal-field">
          <%= form.label :email, "Email address" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "name@company.com", class: "portal-control" %>
        </div>
        <div class="portal-field">
          <%= form.label :role_key, "What can they do?" %>
          <%= form.select :role_key, options_for_select(RoleLabels.options_for_roles(@allowed_roles)), {}, class: "portal-control" %>
        </div>
        <p class="portal-notice mb-5">Invited people only see work and files your organisation has shared with them.</p>
        <%= form.submit "Send invitation", class: "ant-btn-primary ant-btn-primary--compact" %>
      <% end %>
    </section>
  </div>
</div>