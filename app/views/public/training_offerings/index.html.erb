<% content_for :public_nav, "training" %>

<%= render "shared/public/page_banner",
      eyebrow: "Training",
      title: "Training and workshops.",
      lede: "Explore what ANT Marine can offer. Registration and scheduling are arranged separately." %>

<section class="public-section public-section--tight-top">
  <% if @training_offerings.any? %>
    <div class="public-service-grid">
      <% @training_offerings.each do |training| %>
        <%= render "shared/public/content_card",
              title: training.public_title,
              summary: training.public_summary,
              url: public_training_offering_path(training.slug),
              icon: "book",
              link_label: "View details" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "book",
          title: "No published training offerings yet",
          description: "Course descriptions appear here after editorial review. Dates and registration are confirmed with the ANT Marine team.",
          primary_action: { label: "Ask about training", path: contact_path } %>
  <% end %>
</section>