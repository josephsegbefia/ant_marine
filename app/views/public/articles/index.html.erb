<% content_for :public_nav, "insights" %>

<%= render "shared/public/page_banner",
      eyebrow: "Insights",
      title: "Useful maritime guidance and updates.",
      lede: "Articles are published only after editorial review." %>

<section class="public-section public-section--tight-top">
  <% if @articles.any? %>
    <div class="public-service-grid">
      <% @articles.each do |article| %>
        <article class="public-service-card">
          <p class="public-eyebrow public-service-card__eyebrow"><%= article.public_category %></p>
          <h3 class="public-service-card__title">
            <%= link_to article.public_title, public_insight_path(article.slug), class: "public-service-card__title-link" %>
          </h3>
          <p class="public-service-card__summary"><%= article.public_summary %></p>
          <%= link_to "Read article", public_insight_path(article.slug), class: "public-text-link" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "file",
          title: "No published articles yet",
          description: "Insights and guidance will appear here when editorial content is approved for the public site.",
          primary_action: { label: "Explore services", path: public_services_path } %>
  <% end %>
</section>