<% content_for :public_nav, "projects" %>

<%= render "shared/public/page_banner",
      eyebrow: "Our work",
      title: "Projects and experience.",
      lede: "Examples are published only with appropriate client permission." %>

<section class="public-section public-section--tight-top">
  <% if @case_studies.any? %>
    <div class="public-service-grid">
      <% @case_studies.each do |study| %>
        <%= render "shared/public/content_card",
              title: study.public_title,
              summary: study.public_summary,
              url: public_project_path(study.slug),
              icon: "brief",
              link_label: "View story" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "brief",
          title: "Approved project stories are not available yet",
          description: "We share case studies only when clients have given permission and content has passed editorial review.",
          guidance: "You can still discuss a similar project with our team.",
          primary_action: { label: "Contact the team", path: contact_path } %>
  <% end %>
</section>