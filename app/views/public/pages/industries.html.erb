<% content_for :public_nav, "industries" %>

<section class="public-section public-page-banner">
  <p class="public-eyebrow">Who we work with</p>
  <h1><%= @page.public_title %></h1>
  <p class="public-hero__lede"><%= @page.public_summary.presence || "Support tailored to complex marine environments and projects." %></p>
</section>

<section class="public-section">
  <%= public_format_text(@page.public_body) if @page.public_body.present? %>
  <div class="public-service-grid mt-6">
    <% (@page.public_page_data["industry_cards"] || []).each do |card| %>
      <article class="portal-card public-service-card">
        <h2><%= card["title"] %></h2>
        <p><%= card["description"] %></p>
      </article>
    <% end %>
  </div>
</section>