<% content_for :public_nav, "resources" %>
<section class="public-section public-page-banner">
  <p class="public-eyebrow">Resources</p>
  <h1>Guides and publications.</h1>
  <p class="public-hero__lede">Approved resources will appear here. Downloads require a separate release step.</p>
</section>
<section class="public-section">
  <% if @resources.any? %>
    <div class="public-service-grid">
      <% @resources.each do |resource| %>
        <article class="portal-card public-service-card">
          <p class="text-xs font-bold text-[#5f7d8c]"><%= resource.public_resource_category %></p>
          <h2><%= resource.public_title %></h2>
          <p><%= resource.public_summary %></p>
          <p><%= link_to "View details", public_resource_path(resource.slug) %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="portal-card"><p>No resources are published yet.</p></div>
  <% end %>
</section>