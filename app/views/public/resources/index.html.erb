<% content_for :public_nav, "resources" %>

<%= render "shared/public/page_banner",
      eyebrow: "Resources",
      title: "Guides and publications.",
      lede: "Approved resources will appear here. Public file downloads require a separate release step." %>

<section class="public-section public-section--tight-top">
  <% if @resources.any? %>
    <div class="public-service-grid">
      <% @resources.each do |resource| %>
        <%= render "shared/public/content_card",
              title: resource.public_title,
              summary: resource.public_summary,
              url: public_resource_path(resource.slug),
              icon: "file",
              eyebrow: resource.public_resource_category,
              link_label: "View details" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "file",
          title: "No public resources available yet",
          description: "Catalogue entries and downloads are published only after storage and release approval.",
          primary_action: { label: "Contact the team", path: contact_path } %>
  <% end %>
</section>