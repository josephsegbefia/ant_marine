<% content_for :public_nav, "resources" %>

<%= render "shared/public/page_banner",
      eyebrow: "Resources",
      title: "Guides and publications.",
      lede: "Approved resources will appear here. Public file downloads require a separate release step." %>

<section class="public-section public-section--tight-top">
  <% if @resources.any? %>
    <div class="public-service-grid">
      <% @resources.each do |resource| %>
        <article class="public-service-card">
          <span class="public-service-card__icon" aria-hidden="true"><%= render "shared/public/icon", name: "file", size: 22 %></span>
          <p class="public-eyebrow public-service-card__eyebrow"><%= resource.public_resource_category %></p>
          <h3 class="public-service-card__title">
            <%= link_to resource.public_title, public_resource_path(resource.slug), class: "public-service-card__title-link" %>
          </h3>
          <p class="public-service-card__summary"><%= resource.public_summary %></p>
          <%= link_to "View details", public_resource_path(resource.slug), class: "public-text-link" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "file",
          title: "No public resources available yet",
          description: "Catalogue entries and downloads are published only after storage and release approval.",
          primary_action: { label: "Contact the team", path: contact_path } %>
  <% end %>
</section>