<% content_for :public_nav, "services" %>

<%= render "shared/public/page_banner",
      eyebrow: "Our services",
      title: "Practical help on and off the water.",
      lede: "Find the right support for vessels, marine facilities, offshore operations and technical projects." %>

<section class="public-section public-section--tight-top">
  <% if @services.any? %>
    <div class="public-service-grid">
      <% @services.each do |service| %>
        <%= render "shared/public/service_card", service: service %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "layers",
          title: "No services published yet",
          description: "Service descriptions appear here once they are reviewed and published.",
          guidance: "Describe your needs and we will help you find the right support.",
          primary_action: { label: "Contact the team", path: contact_path } %>
  <% end %>
  <p class="public-notice public-notice--spaced">Not sure which service is right?
    <%= link_to "Describe your needs", contact_path %> and we will help you choose.</p>
</section>