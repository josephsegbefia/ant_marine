<% content_for :public_nav, "services" %>

<%= render "shared/public/page_banner",
      eyebrow: "Our services",
      title: "Practical help on and off the water.",
      lede: "Find the right support for vessels, marine facilities, offshore operations and technical projects." %>

<section class="public-section public-section--sky public-section--tight-top" aria-labelledby="services-catalogue-heading">
  <% if @services.any? %>
    <% unless @services.size == 1 %>
      <header class="public-services-intro">
        <h2 id="services-catalogue-heading" class="sr-only">Published services</h2>
        <p>Browse what we offer today. Each service page explains scope, how we work with you, and what to expect next.</p>
      </header>
    <% end %>
    <%= render "shared/public/card_carousel",
          items: @services, label: "Published services", noun: "service",
          card: "shared/public/service_card_featured", card_locals: { on_services_index: true } %>
  <% else %>
    <%= render "shared/public/empty_state",
          icon: "layers",
          title: "No services published yet",
          description: "Service descriptions appear here once they are reviewed and published.",
          guidance: "Describe your needs and we will help you find the right support.",
          primary_action: { label: "Contact the team", path: contact_path } %>
  <% end %>

  <aside class="public-notice public-notice--spaced public-notice--help" role="note">
    <% if @services.any? && @services.size == 1 %>
      <strong class="public-notice__title">Not sure this is the right fit?</strong>
      <p>Tell us about your vessel, facility or project — or read <%= link_to "how we work", how_we_work_path %> before you get in touch.</p>
      <%= link_to "Describe your needs", public_enquiry_path, class: "ant-btn-outline ant-btn-primary--compact public-notice__action" %>
    <% else %>
      Not sure which service is right?
      <%= link_to "Describe your needs", public_enquiry_path %> and we will help you choose.
    <% end %>
  </aside>
</section>