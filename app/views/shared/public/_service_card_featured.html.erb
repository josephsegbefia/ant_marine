<%# locals: item, on_services_index: false %>
<% service = item %>
<% summary = public_service_card_summary(service) %>
<% highlights = service.public_scope_items.first(4) %>
<article class="public-service-card public-service-card--premium public-service-card--featured public-pattern-surface public-pattern-surface--card">
  <span class="public-service-card__pattern" aria-hidden="true"></span>
  <div class="public-service-card__featured-media">
    <span class="public-service-card__icon public-service-card__icon--featured" aria-hidden="true">
      <%= render "shared/public/icon", name: public_service_icon_key(service), size: 28 %>
    </span>
    <p class="public-eyebrow public-service-card__eyebrow"><%= public_service_category_label(service) %></p>
  </div>
  <div class="public-service-card__featured-body">
    <h3 class="public-service-card__title public-service-card__title--featured">
      <%= link_to service.public_title, public_service_path(service.slug), class: "public-service-card__title-link" %>
    </h3>
    <p class="public-service-card__summary"><%= summary %></p>
    <% if highlights.any? %>
      <ul class="public-service-card__highlights" aria-label="What this covers">
        <% highlights.each do |item| %>
          <li>
            <span class="public-service-card__highlights-icon" aria-hidden="true"><%= render "shared/public/icon", name: "check", size: 14 %></span>
            <%= item %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <footer class="public-service-card__footer public-service-card__footer--featured">
      <%= link_to "Explore this service", public_service_path(service.slug), class: "ant-btn-primary ant-btn-primary--compact" %>
      <% if local_assigns[:on_services_index] %>
        <%= link_to "Contact the team", contact_path, class: "public-text-link" %>
      <% else %>
        <%= link_to "All services", public_services_path, class: "public-text-link" %>
      <% end %>
    </footer>
  </div>
</article>