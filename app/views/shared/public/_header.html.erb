<header class="public-header" data-controller="public-nav">
  <%= link_to root_path, class: "public-header__brand" do %>
    <span class="public-header__brand-icon" aria-hidden="true">≈</span>
    <span>
      <strong>ANT Marine W.A.</strong>
      <small>Marine Consulting</small>
    </span>
  <% end %>

  <button type="button"
          class="public-header__menu-toggle"
          data-public-nav-target="toggle"
          data-action="public-nav#toggle"
          aria-expanded="false"
          aria-controls="public-primary-nav">
    <span>Menu</span>
  </button>

  <nav id="public-primary-nav"
       class="public-header__nav"
       aria-label="Website"
       data-public-nav-target="nav">
    <% public_primary_nav_links.each do |link| %>
      <%= link_to link[:label],
            public_nav_path(link),
            class: "public-header__link#{" public-header__link--active" if public_nav_active?(link[:key])}" %>
    <% end %>
    <details class="public-header__more">
      <summary class="public-header__more-summary">More</summary>
      <div class="public-header__more-panel">
        <% public_secondary_nav_links.each do |link| %>
          <%= link_to link[:label],
                public_nav_path(link),
                class: "public-header__link#{" public-header__link--active" if public_nav_active?(link[:key])}" %>
        <% end %>
      </div>
    </details>
    <%= link_to "Sign in", new_session_path, class: "public-header__cta" %>
  </nav>
</header>