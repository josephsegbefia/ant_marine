<%# locals: title:, description:, action_label:, action_path: %>
<section class="public-section public-cta-section" aria-labelledby="public-cta-heading">
  <div class="public-cta">
    <div class="public-cta__copy">
      <h2 id="public-cta-heading"><%= title %></h2>
      <p><%= description %></p>
    </div>
    <div class="public-cta__actions">
      <%= link_to action_label, action_path, class: "public-cta__btn" %>
      <p class="public-cta__note">
        Already working with us? <%= link_to "Sign in to your workspace", new_session_path %>
      </p>
    </div>
  </div>
</section>
