<%# locals: eyebrow:, title:, lede:, primary_action: nil %>
<section class="public-page-banner" aria-labelledby="public-page-banner-heading">
  <% if local_assigns[:eyebrow].present? %>
    <p class="public-eyebrow"><%= eyebrow %></p>
  <% end %>
  <h1 id="public-page-banner-heading"><%= title %></h1>
  <% if local_assigns[:lede].present? %>
    <p class="public-page-banner__lede"><%= lede %></p>
  <% end %>
  <% action = local_assigns[:primary_action] %>
  <% if action.present? %>
    <div class="public-page-banner__actions">
      <%= link_to action[:label], action[:path], class: action[:class].presence || "ant-btn-primary ant-btn-primary--compact" %>
    </div>
  <% end %>
</section>