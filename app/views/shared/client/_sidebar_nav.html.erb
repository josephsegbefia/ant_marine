<nav class="client-side-nav" aria-label="Client workspace navigation">
  <%= link_to client_root_path,
        class: "client-nav-button#{" client-nav-button--active" if client_nav_active?(:home)}" do %>
    <%= render "shared/staff/nav_icon", name: "home" %>
    <span>Overview</span>
  <% end %>

  <% if client_can_view_requests? %>
    <%= link_to client_requests_path,
          class: "client-nav-button#{" client-nav-button--active" if client_nav_active?(:requests)}" do %>
      <%= render "shared/staff/nav_icon", name: "clipboard" %>
      <span>Service requests</span>
    <% end %>
  <% end %>

  <% if client_can_view_quotations? %>
    <%= link_to client_quotations_path,
          class: "client-nav-button#{" client-nav-button--active" if client_nav_active?(:quotations)}" do %>
      <%= render "shared/staff/nav_icon", name: "file" %>
      <span>Quotations</span>
    <% end %>
  <% end %>

  <% if client_can_invite? %>
    <%= link_to client_invitations_path,
          class: "client-nav-button#{" client-nav-button--active" if client_nav_active?(:invitations)}" do %>
      <%= render "shared/staff/nav_icon", name: "mail" %>
      <span>Team invitations</span>
    <% end %>
  <% end %>

  <%= link_to client_account_path,
        class: "client-nav-button#{" client-nav-button--active" if client_nav_active?(:account)}" do %>
    <%= render "shared/staff/nav_icon", name: "users" %>
    <span>Account</span>
  <% end %>
</nav>
