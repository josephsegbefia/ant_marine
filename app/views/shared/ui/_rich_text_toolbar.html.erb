<%# id: required unique toolbar id for trix-editor toolbar="..." %>
<trix-toolbar id="<%= toolbar_id %>" class="ant-rich-text-toolbar">
  <div class="ant-rich-text-toolbar__row" role="toolbar" aria-label="Text formatting">
    <div class="ant-rich-text-toolbar__group">
      <label class="sr-only" for="<%= toolbar_id %>_heading">Text style</label>
      <select id="<%= toolbar_id %>_heading"
              class="ant-rich-text-toolbar__heading"
              data-rich-text-editor-target="headingSelect"
              data-action="change->rich-text-editor#setHeading"
              aria-label="Text style">
        <option value="paragraph">Paragraph</option>
        <option value="heading2">Section heading</option>
        <option value="heading3">Subheading</option>
      </select>
    </div>

    <span class="ant-rich-text-toolbar__divider" aria-hidden="true"></span>

    <div class="ant-rich-text-toolbar__group" role="group" aria-label="Inline style">
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="bold" title="Bold" aria-label="Bold">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="italic" title="Italic" aria-label="Italic">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="underline" title="Underline" aria-label="Underline">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" y1="20" x2="20" y2="20"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="strike" title="Strikethrough" aria-label="Strikethrough">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 4H9a3 3 0 0 0 0 6h6a3 3 0 0 1 0 6H6"/><line x1="4" y1="12" x2="20" y2="12"/></svg>
      </button>
    </div>

    <span class="ant-rich-text-toolbar__divider" aria-hidden="true"></span>

    <div class="ant-rich-text-toolbar__group" role="group" aria-label="Lists and quote">
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="bullet" title="Bulleted list" aria-label="Bulleted list">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.2" fill="currentColor"/><circle cx="4" cy="12" r="1.2" fill="currentColor"/><circle cx="4" cy="18" r="1.2" fill="currentColor"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="number" title="Numbered list" aria-label="Numbered list">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4M4 11h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="quote" title="Block quote" aria-label="Block quote">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 10h4v10H3zM15 10h4v10h-4z"/></svg>
      </button>
    </div>

    <span class="ant-rich-text-toolbar__divider ant-rich-text-toolbar__divider--hide-sm" aria-hidden="true"></span>

    <div class="ant-rich-text-toolbar__group" role="group" aria-label="Link">
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="href" title="Insert or edit link" aria-label="Insert or edit link">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10 13a5 5 0 0 1 0-7l1-1a5 5 0 0 1 7 7l-1 1"/><path d="M14 11a5 5 0 0 1 0 7l-1 1a5 5 0 0 1-7-7l1-1"/></svg>
      </button>
    </div>

    <div class="ant-rich-text-toolbar__group ant-rich-text-toolbar__group--more">
      <button type="button"
              class="ant-rich-text-toolbar__btn ant-rich-text-toolbar__btn--more"
              data-rich-text-editor-target="moreTrigger"
              data-action="click->rich-text-editor#toggleMore"
              aria-expanded="false"
              aria-haspopup="true"
              title="More formatting"
              aria-label="More formatting">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="5" cy="12" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><circle cx="19" cy="12" r="1.2" fill="currentColor"/></svg>
        <span class="ant-rich-text-toolbar__more-label">More</span>
      </button>
      <div class="ant-rich-text-toolbar__more-panel"
           data-rich-text-editor-target="morePanel"
           role="group"
           aria-label="More formatting"
           hidden>
        <button type="button" class="ant-rich-text-toolbar__btn" data-trix-action="increaseNestingLevel" title="Indent" aria-label="Indent">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="21" y1="6" x2="11" y2="6"/><line x1="21" y1="12" x2="11" y2="12"/><line x1="21" y1="18" x2="11" y2="18"/><path d="M4 8l4 4-4 4"/></svg>
        </button>
        <button type="button" class="ant-rich-text-toolbar__btn" data-trix-action="decreaseNestingLevel" title="Outdent" aria-label="Outdent">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="21" y1="6" x2="11" y2="6"/><line x1="21" y1="12" x2="11" y2="12"/><line x1="21" y1="18" x2="11" y2="18"/><path d="M4 16l-4-4 4-4"/></svg>
        </button>
        <button type="button" class="ant-rich-text-toolbar__btn" data-trix-attribute="code" title="Code block" aria-label="Code block">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </button>
        <button type="button"
                class="ant-rich-text-toolbar__btn"
                data-action="click->rich-text-editor#clearFormatting"
                title="Clear formatting"
                aria-label="Clear formatting">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 4h6v6"/><path d="M19 4 9 14"/><path d="M5 20 15 10"/><path d="M9 20h6"/></svg>
        </button>
      </div>
    </div>

    <div class="ant-rich-text-toolbar__group ant-rich-text-toolbar__group--end" role="group" aria-label="Undo and redo">
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-action="undo" title="Undo" aria-label="Undo">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a4 4 0 0 1 0 8h-1"/></svg>
      </button>
      <button type="button" class="ant-rich-text-toolbar__btn" data-trix-action="redo" title="Redo" aria-label="Redo">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 14 5-5-5-5"/><path d="M20 9H9a4 4 0 0 0 0 8h1"/></svg>
      </button>
    </div>
  </div>
</trix-toolbar>