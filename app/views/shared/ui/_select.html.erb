<% field_id = html_options[:id] || [ form.object_name.presence, method ].compact.join("_") %>
<% label_text = local_assigns[:label] || method.to_s.humanize %>
<% invalid = error.present? %>

<%= render "shared/ui/select_core",
           field_id: field_id,
           label_html: form.label(method, label_text, class: "ant-field__label", for: field_id, id: "#{field_id}_label"),
           native_html: form.select(
             method,
             choices,
             select_options,
             {
               id: field_id,
               class: "ant-select__native",
               data: { custom_select_target: "native" },
               aria: {
                 invalid: invalid,
                 describedby: [ hint.present? ? "#{field_id}-hint" : nil, invalid ? "#{field_id}-error" : nil ].compact.join(" ").presence
               }.compact
             }.merge(html_options)
           ),
           wrapper_class: context == :portal ? "ant-field ant-field--portal" : "ant-field field-wrap",
           placeholder: placeholder,
           searchable: searchable,
           hint: hint,
           error: error,
           current_label: nil %>
