<nav class="staff-side-nav" aria-label="Workspace navigation">
  <%= link_to staff_root_path,
        class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:overview)}" do %>
    <%= render "shared/staff/nav_icon", name: "home" %>
    <span>Overview</span>
  <% end %>

  <% if staff_can_invite? %>
    <%= link_to staff_invitations_path,
          class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:invitations)}" do %>
      <%= render "shared/staff/nav_icon", name: "mail" %>
      <span>Invitations</span>
    <% end %>
  <% end %>

  <% if staff_can_view_enquiries? %>
    <%= link_to staff_service_inquiries_path,
          class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:enquiries)}" do %>
      <%= render "shared/staff/nav_icon", name: "inbox" %>
      <span>Enquiries</span>
    <% end %>
  <% end %>

  <% if staff_can_manage_quotations? %>
    <%= link_to staff_quotations_path,
          class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:quotations)}" do %>
      <%= render "shared/staff/nav_icon", name: "brief" %>
      <span>Quotations</span>
    <% end %>
  <% end %>

  <p class="staff-side-label staff-side-label--spaced">ADMINISTRATION</p>
  <% if staff_can_manage_website? %>
    <%= link_to staff_website_services_path,
          class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:website)}" do %>
      <%= render "shared/staff/nav_icon", name: "globe" %>
      <span>Website</span>
    <% end %>
  <% else %>
    <p class="staff-nav-note">Website editing requires content permissions.</p>
  <% end %>
</nav>