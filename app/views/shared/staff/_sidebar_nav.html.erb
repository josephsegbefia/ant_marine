<nav class="staff-side-nav" aria-label="Workspace navigation">
  <%= link_to staff_root_path,
        class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:overview)}" do %>
    <%= render "shared/staff/nav_icon", name: "home" %>
    <span>Overview</span>
  <% end %>

  <% if staff_can_invite? %>
    <%= link_to staff_invitations_path,
          class: "staff-nav-button#{" staff-nav-button--active" if staff_nav_active?(:invitations)}" do %>
      <%= render "shared/staff/nav_icon", name: "mail" %>
      <span>Invitations</span>
    <% end %>
  <% end %>

  <p class="staff-side-label staff-side-label--spaced">ADMINISTRATION</p>
  <p class="staff-nav-note">Company settings, website content, and audit views (Design Studio M01–M13) will use this area. No administration routes are available yet.</p>
</nav>