<aside class="staff-app-side" aria-label="Staff workspace">
  <div class="staff-app-side__inner">
    <div class="px-2 pt-1">
      <%= render "shared/ant_marine_brand" %>
    </div>

    <div class="staff-org-card">
      <div class="staff-org-card__avatar" aria-hidden="true">AM</div>
      <div class="min-w-0">
        <div class="staff-org-card__name"><%= Current.membership.organization.name %></div>
        <small class="staff-org-card__meta">Team workspace</small>
        <% if staff_multiple_workspaces? %>
          <%= link_to "Switch workspace", workspace_selection_path, class: "staff-org-card__switch" %>
        <% end %>
      </div>
    </div>

    <button type="button"
            class="staff-mobile-nav-toggle"
            data-staff-shell-target="toggle"
            data-action="staff-shell#toggle"
            aria-expanded="false"
            aria-controls="staff-workspace-nav">
      Menu
    </button>

    <div id="staff-workspace-nav" class="staff-app-side__nav" data-staff-shell-target="nav">
      <p class="staff-side-label">WORKSPACE</p>
      <%= render "shared/staff/sidebar_nav" %>
      <%= render "shared/staff/user_footer" %>
    </div>
  </div>
</aside>