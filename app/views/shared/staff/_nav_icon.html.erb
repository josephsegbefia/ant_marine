<%# locals: name, size (optional) %>
<% icon_size = local_assigns.fetch(:size, 17) %>
<svg class="staff-nav-icon" width="<%= icon_size %>" height="<%= icon_size %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case name.to_s %>
  <% when "home" %>
    <path d="m3 10 9-7 9 7v10H4z"></path>
    <path d="M9 20v-7h6v7"></path>
  <% when "mail" %>
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <path d="m3 7 9 6 9-6"></path>
    <path d="M16 3v4M19 3v4"></path>
  <% when "switch" %>
    <path d="m8 7-4 4 4 4"></path>
    <path d="m16 17 4-4-4-4"></path>
    <path d="M20 13H4"></path>
  <% when "menu" %>
    <path d="M4 6h16M4 12h16M4 18h16"></path>
  <% when "inbox" %>
    <path d="M22 12h-6l-2 3h-4l-2-3H2"></path>
    <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
  <% when "bell" %>
    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
  <% when "brief" %>
    <rect x="3" y="7" width="18" height="13" rx="2"></rect>
    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
    <path d="M3 12h18"></path>
  <% when "users" %>
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
    <circle cx="9" cy="7" r="4"></circle>
    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
  <% when "clipboard" %>
    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
    <rect x="9" y="3" width="6" height="4" rx="1"></rect>
    <path d="M9 12h6M9 16h6"></path>
  <% when "check" %>
    <path d="M20 6 9 17l-5-5"></path>
  <% when "clock" %>
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7v5l3 2"></path>
  <% when "calendar" %>
    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
    <path d="M3 10h18M8 3v4M16 3v4"></path>
  <% when "file" %>
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
    <path d="M14 2v6h6"></path>
  <% when "globe" %>
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18"></path>
    <path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"></path>
  <% else %>
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 8v4"></path>
    <path d="M12 16h.01"></path>
  <% end %>
</svg>
