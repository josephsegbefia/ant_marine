<% content_for :title, "ANT Marine W.A. — Marine expertise" %>
<% content_for :public_nav, "home" %>

<section class="public-hero">
  <div class="public-hero__copy">
    <p class="public-eyebrow">Practical maritime expertise · Ghana &amp; West Africa</p>
    <h1>Marine expertise for projects that matter.</h1>
    <p class="public-hero__lede">
      From vessel surveys and engineering advice to offshore projects and training, we help you move forward with confidence.
    </p>
    <div class="public-hero__actions">
      <a href="#contact" class="ant-btn-primary ant-btn-primary--compact public-hero__btn">Get in touch</a>
      <a href="#services" class="ant-btn-outline ant-btn-primary--compact public-hero__btn">Explore services</a>
    </div>
  </div>
  <div class="public-hero__art" aria-hidden="true"></div>
</section>

<div class="public-trust-bar" role="list" aria-label="Service areas">
  <span role="listitem">Marine surveys</span>
  <span role="listitem">Project support</span>
  <span role="listitem">Environmental and safety checks</span>
  <span role="listitem">Training</span>
</div>

<section class="public-section" id="services">
  <header class="public-section__head">
    <h2>How we can help</h2>
    <p>Full service pages will be added as the public website expands.</p>
  </header>
  <div class="public-service-grid">
    <article class="portal-card public-service-card">
      <h3>Marine surveys</h3>
      <p>Inspections, marine warranty surveys and vessel condition checks.</p>
    </article>
    <article class="portal-card public-service-card">
      <h3>Project support</h3>
      <p>Drydock, marine project and technical management services.</p>
    </article>
    <article class="portal-card public-service-card">
      <h3>Training</h3>
      <p>Professional marine training aligned to your team’s needs.</p>
    </article>
  </div>
</section>

<section class="public-section public-section--muted" id="contact">
  <header class="public-section__head">
    <h2>Contact</h2>
    <p>Tell us about your project. Existing clients can use the secure portal for ongoing work.</p>
  </header>
  <div class="portal-card public-contact-card">
    <p class="text-sm leading-relaxed text-[#5f7d8c]">
      Online quote and booking forms are not available yet. To start a new enquiry, contact ANT Marine through your usual channel
      or <%= link_to "sign in", new_session_path %> if you already have a workspace invitation.
    </p>
  </div>
</section>