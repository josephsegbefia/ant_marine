<%# locals: item, key, editable %>
<% prefix = "quote_revision[line_items_attributes][#{key}]" %>
<% dom = "quote_line_#{key}" %>
<% removed = item.marked_for_destruction? %>
<li
  class="staff-quote-line"
  data-quote-pricing-target="row"
  data-persisted="<%= item.persisted? %>"
  <%= "hidden data-removed=true" if removed %>
>
  <% if item.persisted? %>
    <input type="hidden" name="<%= prefix %>[id]" value="<%= item.id %>">
  <% end %>
  <input type="hidden" name="<%= prefix %>[position]" value="<%= item.position %>" data-quote-pricing-target="position">
  <input type="hidden" name="<%= prefix %>[_destroy]" value="<%= removed ? 1 : 0 %>" data-quote-pricing-target="destroy">

  <div class="staff-quote-line__head">
    <p class="staff-quote-line__label" data-quote-pricing-target="number">Pricing line</p>
    <% if editable %>
      <div class="staff-quote-line__tools">
        <button type="button" class="staff-quote-line__tool" data-action="quote-pricing#moveUp" aria-label="Move line up">↑</button>
        <button type="button" class="staff-quote-line__tool" data-action="quote-pricing#moveDown" aria-label="Move line down">↓</button>
        <button type="button" class="staff-quote-line__tool staff-quote-line__tool--remove" data-action="quote-pricing#remove">Remove</button>
      </div>
    <% end %>
  </div>

  <div class="staff-quote-line__grid">
    <div class="staff-quote-line__description">
      <label class="ant-field__label" for="<%= dom %>_description">Description</label>
      <input class="ant-control w-full" id="<%= dom %>_description" name="<%= prefix %>[description]"
             value="<%= item.description %>" maxlength="500" placeholder="For example: Underwater hull inspection">
    </div>
    <div>
      <label class="ant-field__label" for="<%= dom %>_quantity">Quantity</label>
      <input class="ant-control w-full" id="<%= dom %>_quantity" name="<%= prefix %>[quantity]" value="<%= item.quantity_input %>"
             inputmode="decimal" autocomplete="off" data-quote-pricing-target="quantity" data-action="input->quote-pricing#recalculate">
    </div>
    <div class="staff-quote-line__unit">
      <label class="ant-field__label" for="<%= dom %>_unit_choice">Unit</label>
      <select class="ant-control w-full" id="<%= dom %>_unit_choice" name="<%= prefix %>[unit_choice]"
              data-quote-pricing-target="unitChoice" data-action="change->quote-pricing#unitChanged"
              <% if item.errors[:unit].any? %>aria-invalid="true"<% end %>>
        <% QuoteLineItem::COMMON_UNITS.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if item.unit_choice == value %>><%= label %></option>
        <% end %>
        <option value="<%= QuoteLineItem::OTHER_UNIT %>" <%= "selected" if item.unit_choice == QuoteLineItem::OTHER_UNIT %>>Other…</option>
      </select>
      <div class="staff-quote-line__unit-other" data-quote-pricing-target="unitOtherField"
           <%= "hidden" unless item.unit_choice == QuoteLineItem::OTHER_UNIT %>>
        <label class="ant-field__label" for="<%= dom %>_unit_other">Your unit</label>
        <input class="ant-control w-full" id="<%= dom %>_unit_other" name="<%= prefix %>[unit_other]" value="<%= item.unit_other %>"
               maxlength="<%= QuoteLineItem::CUSTOM_UNIT_MAX %>" autocomplete="off" placeholder="For example: tonne"
               data-quote-pricing-target="unitOther"
               <% unless item.unit_choice == QuoteLineItem::OTHER_UNIT %>disabled<% end %>>
      </div>
    </div>
    <div>
      <label class="ant-field__label" for="<%= dom %>_unit_price">Unit price</label>
      <div class="staff-quote-line__money">
        <span class="staff-quote-line__currency" data-quote-pricing-target="currencyLabel" aria-hidden="true"><%= item.currency %></span>
        <input class="ant-control w-full" id="<%= dom %>_unit_price" name="<%= prefix %>[unit_price]" value="<%= item.unit_price %>"
               inputmode="decimal" autocomplete="off" placeholder="0.00"
               data-quote-pricing-target="price" data-action="input->quote-pricing#recalculate">
      </div>
    </div>
    <div class="staff-quote-line__total">
      <span class="ant-field__label">Line total</span>
      <output data-quote-pricing-target="lineTotal" for="<%= dom %>_quantity <%= dom %>_unit_price">
        <%= format_quote_money(item.line_total_cents, item.currency) %>
      </output>
    </div>
  </div>

  <% if item.errors.any? %>
    <ul class="staff-quote-line__errors" role="alert">
      <% item.errors.map(&:message).uniq.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
</li>
