<% content_for :staff_nav, :quotations %>

<%= ant_page_header(
      title: "New quotation",
      description: "Start a draft commercial quotation. Nothing is saved until you begin the draft.",
      primary_action: nil
    ) %>

<section class="staff-website-hub mt-6 max-w-2xl">
  <div class="portal-card p-6 sm:p-8">
    <p class="text-sm leading-relaxed text-[#5f7d8c]">
      You will enter client details, scope, pricing and terms in a guided editor. A reference number is assigned when you start the draft.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= button_to "Begin draft quotation", staff_quotations_path, method: :post, class: "ant-btn-primary ant-btn-primary--compact" %>
      <%= ant_back_link label: "Back to quotations", path: staff_quotations_path %>
    </div>
  </div>
</section>