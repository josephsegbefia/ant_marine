<%# locals: quote, revision, editor_step %>
<% editor_step = local_assigns[:editor_step] || 1 %>
<% editable = quote.editable? %>
<% steps = ["Client", "Scope", "Pricing", "Terms", "Review"] %>

<div class="staff-editor-head">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="public-eyebrow"><%= quote.reference_number %></p>
      <h1 class="staff-editor-head__title" id="staff-quotation-editor-heading">Prepare quotation</h1>
      <p class="staff-editor-head__lede">Guide the client details, scope, pricing and terms. Save drafts as you go.</p>
    </div>
    <%= ant_status_badge(label: quote_status_label(quote.status), badge_class: quote_status_badge_variant(quote.status)) %>
  </div>
</div>

<%= form_with url: staff_quotation_path(quote), method: :patch, class: "staff-editor", data: { controller: "form-submit" } do %>
  <input type="hidden" name="editor_step" value="<%= editor_step %>">
  <input type="hidden" name="quote[lock_version]" value="<%= quote.lock_version %>">

  <nav class="staff-editor-stepper" aria-label="Quotation steps">
    <% steps.each_with_index do |label, index| %>
      <% step_number = index + 1 %>
      <%= link_to label,
            edit_staff_quotation_path(quote, editor_step: step_number),
            class: "staff-editor-step__tab #{"staff-editor-step__tab--current" if step_number == editor_step}" %>
    <% end %>
  </nav>

  <div class="portal-card staff-editor-card mt-4">
    <% case editor_step %>
    <% when 1 %>
      <%= render "staff/quotations/steps/client", quote: quote, client_organizations: @client_organizations, editable: editable %>
    <% when 2 %>
      <%= render "staff/quotations/steps/scope", quote: quote, revision: revision, services: @services, editable: editable %>
    <% when 3 %>
      <%= render "staff/quotations/steps/pricing", revision: revision, editable: editable %>
    <% when 4 %>
      <%= render "staff/quotations/steps/terms", revision: revision, editable: editable %>
    <% when 5 %>
      <%= render "staff/quotations/steps/review", quote: quote, revision: revision %>
    <% end %>
  </div>

  <footer class="staff-editor-footer mt-4 flex flex-wrap gap-2">
    <%= ant_back_link label: "Back to quotations", path: staff_quotations_path %>
    <% if editable %>
      <button type="submit" name="commit" value="save" class="ant-btn-outline ant-btn-primary--compact">Save draft</button>
      <button type="submit" name="commit" value="save_continue" class="ant-btn-outline ant-btn-primary--compact">Save and continue</button>
      <% if editor_step < 5 %>
        <button type="submit" name="commit" value="review" class="ant-btn-primary ant-btn-primary--compact">Review quotation</button>
      <% end %>
    <% end %>
    <% if editor_step == 5 %>
      <%= link_to "Download PDF", pdf_staff_quotation_path(quote), class: "ant-btn-outline ant-btn-primary--compact", target: "_blank", rel: "noopener" %>
    <% end %>
  </footer>
<% end %>

<% if editor_step == 5 %>
  <%= render "staff/quotations/workflow", quote: quote, revision: revision %>
<% end %>