<%# locals: quote, revision, readiness %>
<section class="staff-quote-side-panel staff-quote-summary" aria-labelledby="quote-summary-heading">
  <%= render "shared/ui/side_panel_head",
        title: "Quotation summary",
        heading_id: "quote-summary-heading",
        icon: "file",
        badge_label: quote_status_label(quote.status),
        badge_class: quote_status_badge_variant(quote.status) %>

  <div class="staff-quote-side-panel__body">
    <dl class="staff-quote-summary__list">
      <div>
        <dt>Reference</dt>
        <dd class="staff-quote-summary__ref"><%= quote.reference_number %></dd>
      </div>
      <div>
        <dt>Version</dt>
        <dd><%= revision.version_number %></dd>
      </div>
      <div>
        <dt>Client</dt>
        <dd><%= quote.client_label %></dd>
      </div>
      <div>
        <dt>Saved total</dt>
        <dd><%= format_quote_money(revision.total_cents, revision.currency) %></dd>
      </div>
      <div>
        <dt>Valid until</dt>
        <dd><%= revision.valid_until ? l(revision.valid_until, format: :long) : "Not set" %></dd>
      </div>
      <div>
        <dt>Client delivery</dt>
        <dd><%= quote_delivery_summary(quote) %></dd>
      </div>
    </dl>

    <div class="staff-quote-summary__next">
      <p class="staff-quote-summary__next-label">Next</p>
      <p class="staff-quote-summary__next-value"><%= quote.next_action_label %></p>
      <% if quote.editable? && !readiness.ready? %>
        <p class="staff-quote-summary__hint"><%= pluralize(readiness.issues.size, "item") %> to complete before review.</p>
      <% end %>
    </div>
  </div>
</section>
