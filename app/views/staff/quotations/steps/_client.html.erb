<% pc = quote.prospective_client %>
<fieldset class="space-y-4" <%= "disabled" unless editable %>>
  <legend class="sr-only">Client information</legend>
  <div>
    <label class="ant-field__label" for="quote_client_organization_id">Existing client organisation</label>
    <select name="quote[client_organization_id]" id="quote_client_organization_id" class="ant-control w-full">
      <option value="">Not linked yet</option>
      <% client_organizations.each do |org| %>
        <option value="<%= org.id %>" <%= "selected" if quote.client_organization_id == org.id %>><%= org.name %></option>
      <% end %>
    </select>
    <p class="ant-field__hint">Link a client organisation when they are already on the portal. Otherwise capture prospective details below.</p>
  </div>
  <% %i[company_name contact_name email phone address].each do |field| %>
    <div>
      <label class="ant-field__label" for="quote_prospective_client_<%= field %>"><%= field.to_s.humanize %></label>
      <input class="ant-control w-full" id="quote_prospective_client_<%= field %>" name="quote[prospective_client][<%= field %>]" value="<%= pc[field.to_s] %>" <%= "required" if field == :company_name && quote.client_organization_id.blank? %>>
    </div>
  <% end %>
</fieldset>