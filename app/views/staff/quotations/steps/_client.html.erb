<%# locals: quote, client_organizations, editable %>
<fieldset class="mt-4 space-y-4" <%= "disabled" unless editable %>>
  <legend class="sr-only">Client information</legend>
  <p class="text-sm text-[#5f7d8c]">Choose an existing client, or enter the details of a prospective client. A contact name and email are needed before review.</p>

  <%= ant_select_tag "quote[client_organization_id]", client_organizations.map { |org| [ org.name, org.id ] },
                     id: "quote_client_organization_id", label: "Existing client organisation",
                     selected: quote.client_organization_id, include_blank: "Not an existing client",
                     searchable: true, error: quote.errors[:client_organization_id].to_sentence.presence %>

  <div class="ant-field ant-field--portal">
    <label class="ant-field__label" for="quote_prospective_client_company_name">Company name (if not an existing client)</label>
    <input class="ant-control w-full" id="quote_prospective_client_company_name" name="quote[prospective_client][company_name]"
           value="<%= quote.prospective_value("company_name") %>" maxlength="200" autocomplete="organization">
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="ant-field ant-field--portal">
      <label class="ant-field__label" for="quote_prospective_client_contact_name">Contact name</label>
      <input class="ant-control w-full" id="quote_prospective_client_contact_name" name="quote[prospective_client][contact_name]"
             value="<%= quote.prospective_value("contact_name") %>" maxlength="200" autocomplete="name">
    </div>
    <div class="ant-field ant-field--portal">
      <label class="ant-field__label" for="quote_prospective_client_email">Contact email</label>
      <input type="email" class="ant-control w-full" id="quote_prospective_client_email" name="quote[prospective_client][email]"
             value="<%= quote.prospective_value("email") %>" maxlength="200" autocomplete="email">
    </div>
    <div class="ant-field ant-field--portal">
      <label class="ant-field__label" for="quote_prospective_client_phone">Phone (optional)</label>
      <input type="tel" class="ant-control w-full" id="quote_prospective_client_phone" name="quote[prospective_client][phone]"
             value="<%= quote.prospective_value("phone") %>" maxlength="50" autocomplete="tel">
    </div>
  </div>

  <div class="ant-field ant-field--portal">
    <label class="ant-field__label" for="quote_prospective_client_address">Address (optional)</label>
    <textarea class="ant-control w-full" rows="2" id="quote_prospective_client_address" name="quote[prospective_client][address]" maxlength="500"><%= quote.prospective_value("address") %></textarea>
  </div>
</fieldset>
