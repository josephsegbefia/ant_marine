<fieldset class="space-y-4" <%= "disabled" unless editable %>>
  <legend class="sr-only">Services and scope</legend>
  <div>
    <label class="ant-field__label" for="quote_service_id">Related public service (optional)</label>
    <select name="quote[service_id]" id="quote_service_id" class="ant-control w-full">
      <option value="">None selected</option>
      <% services.each do |service| %>
        <option value="<%= service.id %>" <%= "selected" if quote.service_id == service.id %>><%= service.title %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label class="ant-field__label" for="quote_revision_title">Quotation title</label>
    <input class="ant-control w-full" id="quote_revision_title" name="quote_revision[title]" value="<%= revision.title %>" required>
  </div>
  <% { scope_description: "Scope description", deliverables: "Deliverables", exclusions: "Exclusions", additional_requirements: "Additional agreed requirements" }.each do |field, label| %>
    <div>
      <label class="ant-field__label" for="quote_revision_<%= field %>"><%= label %></label>
      <textarea class="ant-control w-full" rows="4" id="quote_revision_<%= field %>" name="quote_revision[<%= field %>]"><%= revision.public_send(field) %></textarea>
    </div>
  <% end %>
</fieldset>
