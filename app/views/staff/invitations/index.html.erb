<% content_for :title, "Invitations — ANT Marine" %>

<div class="portal-shell">
  <nav class="portal-topnav" aria-label="Staff">
    <%= link_to "Staff workspace", staff_root_path %>
    <span aria-hidden="true">/</span>
    <span>Invitations</span>
  </nav>

  <header class="portal-head">
    <div>
      <h1>Invitations</h1>
      <p>Invite new people and review pending invitations for ANT Marine W.A.</p>
    </div>
    <div>
      <%= link_to "Invite a client contact", new_staff_client_invitation_path, class: "portal-btn-secondary" %>
    </div>
  </header>

  <%= render "shared/auth_flash" %>

  <div class="portal-split">
    <section class="portal-card">
      <h3>Recent invitations</h3>
      <%= render "shared/invitations/list",
            invitations: @invitations,
            show_organization: false,
            cancel_path: ->(invitation) { staff_invitation_path(invitation) },
            resend_path: ->(invitation) { resend_staff_invitation_path(invitation) } %>
    </section>

    <section class="portal-card">
      <h3>Invite someone</h3>
      <%= form_with url: staff_invitations_path, class: "mt-5" do |form| %>
        <div class="portal-field">
          <%= form.label :email, "Email address" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "name@company.com", class: "portal-control" %>
        </div>
        <div class="portal-field">
          <%= form.label :role_key, "What can they do?" %>
          <%= form.select :role_key, options_for_select(RoleLabels.options_for_roles(@allowed_roles)), {}, class: "portal-control" %>
        </div>
        <p class="portal-notice mb-5">An invited person should only see the work and projects they have permission to access.</p>
        <%= form.submit "Send invitation", class: "ant-btn-primary ant-btn-primary--compact" %>
      <% end %>
    </section>
  </div>
</div>