<div class="mx-auto max-w-3xl py-12 px-4">
  <h1 class="text-2xl font-semibold text-gray-900">Staff invitations</h1>
  <p class="mt-2 text-sm text-gray-600">Invite colleagues to the ANT Marine staff workspace (provisional P3-A2 screen).</p>

  <% if flash[:notice] %>
    <p class="login-notice mt-4"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p class="login-alert mt-4"><%= flash[:alert] %></p>
  <% end %>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Invite a colleague</h2>
      <%= form_with url: staff_invitations_path, class: "mt-4 space-y-4" do |form| %>
        <div>
          <%= form.label :email, "Email address", class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, required: true, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= form.label :role_key, "Role", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :role_key, options_for_select(@allowed_roles.map { |r| [r.humanize, r] }), {}, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>
        <%= form.submit "Send invitation", class: "ant-btn-primary ant-btn-primary--compact" %>
      <% end %>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Client invitations</h2>
      <p class="mt-2 text-sm text-gray-600">Invite someone into a client organisation.</p>
      <%= link_to "Invite a client contact", new_staff_client_invitation_path, class: "ant-btn-outline ant-btn-primary--compact mt-4" %>
    </section>
  </div>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-gray-900">Pending and recent</h2>
    <ul class="mt-4 divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white">
      <% @invitations.each do |invitation| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
          <div>
            <p class="font-medium text-gray-900"><%= invitation.email %></p>
            <p class="text-gray-600"><%= invitation.organization.name %> · <%= invitation.role_key %> · <%= invitation.status %></p>
          </div>
          <div class="flex gap-2">
            <% if invitation.status == "pending" %>
              <%= button_to "Cancel", staff_invitation_path(invitation), method: :delete, class: "text-sm text-red-700 underline" %>
              <%= button_to "Resend", resend_staff_invitation_path(invitation), method: :post, class: "text-sm text-blue-700 underline" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <div class="mt-6">
    <%= link_to "Back to staff workspace", staff_root_path, class: "text-sm text-blue-700 underline" %>
  </div>
</div>