<div class="mx-auto max-w-xl py-12 px-4">
  <h1 class="text-2xl font-semibold text-gray-900">Invite a client contact</h1>

  <%= form_with url: staff_client_invitations_path, class: "mt-8 space-y-4 rounded-xl border border-gray-200 bg-white p-6" do |form| %>
    <div>
      <%= form.label :organization_id, "Client organisation", class: "block text-sm font-medium text-gray-700" %>
      <%= form.collection_select :organization_id, @client_organizations, :id, :name, { selected: @organization&.id }, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= form.label :email, "Email address", class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email, required: true, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= form.label :role_key, "Role", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :role_key, options_for_select(@allowed_roles.map { |r| [r.humanize, r] }), {}, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <%= form.submit "Send invitation", class: "ant-btn-primary ant-btn-primary--compact" %>
  <% end %>

  <%= link_to "Back", staff_invitations_path, class: "mt-6 inline-block text-sm text-blue-700 underline" %>
</div>