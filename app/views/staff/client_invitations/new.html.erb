<% content_for :title, "Invite client contact — ANT Marine" %>

<div class="portal-shell">
  <nav class="portal-topnav" aria-label="Staff">
    <%= link_to "Staff workspace", staff_root_path %>
    <span aria-hidden="true">/</span>
    <%= link_to "Invitations", staff_invitations_path %>
    <span aria-hidden="true">/</span>
    <span>Client contact</span>
  </nav>

  <header class="portal-head">
    <div>
      <h1>Invite a client contact</h1>
      <p>Send an invitation to someone joining a client organisation you are authorized to support.</p>
    </div>
  </header>

  <%= render "shared/auth_flash" %>

  <section class="portal-card max-w-xl">
    <% if @client_organizations.empty? %>
      <div class="portal-empty">
        <h3>No client organisations available</h3>
        <p>Client organisations must exist before you can send a client invitation.</p>
      </div>
    <% else %>
      <%= form_with url: staff_client_invitations_path, class: "mt-2" do |form| %>
        <div class="portal-field">
          <%= form.label :organization_id, "Client organisation" %>
          <%= form.collection_select :organization_id, @client_organizations, :id, :name, { selected: @organization&.id }, class: "portal-control" %>
        </div>
        <div class="portal-field">
          <%= form.label :email, "Email address" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "name@company.com", class: "portal-control" %>
        </div>
        <div class="portal-field">
          <%= form.label :role_key, "What can they do?" %>
          <%= form.select :role_key, options_for_select(RoleLabels.options_for_roles(@allowed_roles)), {}, class: "portal-control" %>
        </div>
        <p class="portal-notice mb-5">The invitation is limited to the selected client organisation and role.</p>
        <%= form.submit "Send invitation", class: "ant-btn-primary ant-btn-primary--compact" %>
      <% end %>
    <% end %>
  </section>
</div>