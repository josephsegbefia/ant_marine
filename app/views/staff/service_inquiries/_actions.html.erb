<% transition_url = transition_staff_service_inquiry_path(@inquiry) %>
<% version = @inquiry.lock_version %>
<% open_quote_warning = capture do %>
  <% if @open_quote %>
    <p class="staff-quote-notice staff-quote-notice--warn mb-3">
      Quotation <%= @open_quote.reference_number %> is still open. Closing does not withdraw it — withdraw it from the quotation page first if the offer should no longer stand.
    </p>
  <% end %>
<% end %>

<% @actions.each do |action| %>
  <% case action %>
  <% when "start_review" %>
    <%= button_to "Start review", transition_url, method: :post,
          params: { step: "start_review", expected_lock_version: version },
          class: "ant-btn-primary ant-btn-primary--compact w-full justify-center" %>

  <% when "qualify" %>
    <%= ant_dialog(id: "dialog-qualify", title: "Mark ready to quote", trigger_label: "Mark ready to quote",
                   trigger_class: "ant-btn-outline ant-btn-outline--compact w-full justify-center",
                   description: "Confirm the scope is clear enough to prepare a quotation. This does not send anything to the client.") do %>
      <%= form_with url: transition_url, method: :post, local: true, class: "staff-enquiry-form" do %>
        <input type="hidden" name="step" value="qualify">
        <input type="hidden" name="expected_lock_version" value="<%= version %>">
        <label class="ant-field__label" for="qualify_note">Scope note (optional)</label>
        <textarea name="note" id="qualify_note" rows="3" maxlength="2000" class="ant-control w-full"></textarea>
        <%= ant_select_tag "client_organization_id", @client_organizations.map { |org| [ org.name, org.id ] },
                           id: "qualify_client", label: "Existing client organisation (optional)",
                           selected: @inquiry.client_organization_id, include_blank: "Not linked",
                           searchable: @client_organizations.size > 7, compact: true, wrapper_class: "mt-3",
                           hint: "Link only if you have confirmed this person represents that organisation. No client account is created." %>
        <div class="ant-dialog__actions">
          <button type="button" class="ant-btn-outline ant-btn-outline--compact" data-action="ant-dialog#close">Cancel</button>
          <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Mark ready to quote</button>
        </div>
      <% end %>
    <% end %>

  <% when "mark_duplicate" %>
    <%= ant_dialog(id: "dialog-duplicate", title: "Mark as duplicate", trigger_label: "Mark as duplicate",
                   trigger_class: "ant-btn-outline ant-btn-outline--compact w-full justify-center",
                   description: "Link this enquiry to the original request. Nothing is merged or deleted — both requests keep their own details.") do %>
      <%= form_with url: transition_url, method: :post, local: true, class: "staff-enquiry-form" do %>
        <input type="hidden" name="step" value="mark_duplicate">
        <input type="hidden" name="expected_lock_version" value="<%= version %>">
        <%= open_quote_warning %>
        <label class="ant-field__label" for="duplicate_reference">Reference of the original enquiry</label>
        <input type="text" name="duplicate_reference" id="duplicate_reference" required maxlength="40" class="ant-control w-full"
               autocomplete="off" placeholder="For example ANT-ENQ-2026-00012">
        <label class="ant-field__label mt-3" for="duplicate_note">Note (optional)</label>
        <textarea name="note" id="duplicate_note" rows="2" maxlength="2000" class="ant-control w-full"></textarea>
        <div class="ant-dialog__actions">
          <button type="button" class="ant-btn-outline ant-btn-outline--compact" data-action="ant-dialog#close">Cancel</button>
          <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Mark as duplicate</button>
        </div>
      <% end %>
    <% end %>

  <% when "mark_outside_scope" %>
    <%= ant_dialog(id: "dialog-outside-scope", title: "Mark outside our scope", trigger_label: "Mark outside our scope",
                   trigger_class: "ant-btn-outline ant-btn-outline--compact w-full justify-center",
                   description: "Use this when ANT Marine does not offer the requested work. The enquiry is closed and can be reopened later.") do %>
      <%= form_with url: transition_url, method: :post, local: true, class: "staff-enquiry-form" do %>
        <input type="hidden" name="step" value="mark_outside_scope">
        <input type="hidden" name="expected_lock_version" value="<%= version %>">
        <%= open_quote_warning %>
        <label class="ant-field__label" for="outside_scope_note">Why is this outside our scope?</label>
        <textarea name="note" id="outside_scope_note" rows="3" maxlength="2000" required class="ant-control w-full"></textarea>
        <div class="ant-dialog__actions">
          <button type="button" class="ant-btn-outline ant-btn-outline--compact" data-action="ant-dialog#close">Cancel</button>
          <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Mark outside our scope</button>
        </div>
      <% end %>
    <% end %>

  <% when "close" %>
    <%= ant_dialog(id: "dialog-close", title: "Close enquiry", trigger_label: "Close enquiry",
                   trigger_class: "ant-btn-outline ant-btn-outline--compact w-full justify-center",
                   description: "Closed enquiries keep all their details and history and can be reopened.") do %>
      <%= form_with url: transition_url, method: :post, local: true, class: "staff-enquiry-form" do %>
        <input type="hidden" name="step" value="close">
        <input type="hidden" name="expected_lock_version" value="<%= version %>">
        <%= open_quote_warning %>
        <fieldset>
          <legend class="ant-field__label">Reason</legend>
          <% ServiceInquiry::CLOSE_REASONS.each do |value, label| %>
            <label class="staff-enquiry-choice">
              <input type="radio" name="closure_reason" value="<%= value %>" required> <%= label %>
            </label>
          <% end %>
        </fieldset>
        <label class="ant-field__label mt-3" for="close_note">Explanation (required for “Other”)</label>
        <textarea name="note" id="close_note" rows="3" maxlength="2000" class="ant-control w-full"></textarea>
        <div class="ant-dialog__actions">
          <button type="button" class="ant-btn-outline ant-btn-outline--compact" data-action="ant-dialog#close">Cancel</button>
          <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Close enquiry</button>
        </div>
      <% end %>
    <% end %>

  <% when "reopen" %>
    <%= ant_dialog(id: "dialog-reopen", title: "Reopen enquiry", trigger_label: "Reopen enquiry",
                   trigger_class: "ant-btn-primary ant-btn-primary--compact w-full justify-center",
                   description: "The enquiry returns to review. The earlier closing reason stays in the activity history.") do %>
      <%= form_with url: transition_url, method: :post, local: true, class: "staff-enquiry-form" do %>
        <input type="hidden" name="step" value="reopen">
        <input type="hidden" name="expected_lock_version" value="<%= version %>">
        <label class="ant-field__label" for="reopen_reason">Why is it being reopened?</label>
        <textarea name="reason" id="reopen_reason" rows="3" maxlength="500" required class="ant-control w-full"></textarea>
        <div class="ant-dialog__actions">
          <button type="button" class="ant-btn-outline ant-btn-outline--compact" data-action="ant-dialog#close">Cancel</button>
          <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Reopen enquiry</button>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
