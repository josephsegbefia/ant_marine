<% content_for :staff_nav, :enquiries %>

<%= ant_page_header(
      eyebrow: "Enquiry · #{@inquiry.reference_number}",
      title: @inquiry.company_name,
      description: "#{@inquiry.requested_service_label} · Received #{l(@inquiry.submitted_at, format: :long)} through the #{enquiry_channel_label(@inquiry.channel).downcase}"
    ) %>

<div class="staff-enquiry-workspace mt-4">
  <%= render "staff/service_inquiries/sidebar" %>

  <div class="staff-enquiry-workspace__main">
    <section class="portal-card" aria-labelledby="enquiry-contact-heading">
      <h2 id="enquiry-contact-heading">Request information</h2>
      <dl class="staff-enquiry-facts">
        <div><dt>Company</dt><dd><%= @inquiry.company_name %></dd></div>
        <div><dt>Contact</dt><dd><%= @inquiry.contact_name %></dd></div>
        <div><dt>Email</dt><dd><%= mail_to @inquiry.contact_email, nil, class: "staff-quote-link break-all" %></dd></div>
        <div><dt>Phone</dt><dd><%= @inquiry.contact_phone.presence || "Not provided" %></dd></div>
        <div><dt>Location</dt><dd><%= @inquiry.location %></dd></div>
        <div>
          <dt>Preferred date</dt>
          <dd>
            <% if @inquiry.preferred_date %>
              <%= l(@inquiry.preferred_date, format: :long) %>
              <span class="block text-xs font-normal text-[#5f7d8c]">Requested by the client — not a confirmed booking</span>
            <% else %>
              No date given
            <% end %>
          </dd>
        </div>
      </dl>
      <p class="staff-enquiry-note">An email address on an enquiry does not prove the person works for a client organisation or may accept an offer.</p>
    </section>

    <section class="portal-card" aria-labelledby="enquiry-work-heading">
      <h2 id="enquiry-work-heading">What they need</h2>
      <dl class="staff-enquiry-facts">
        <div><dt>Service</dt><dd><%= @inquiry.requested_service_label %></dd></div>
        <div><dt>Project</dt><dd><%= @inquiry.project_name.presence || "Not provided" %></dd></div>
        <div><dt>Vessel or facility</dt><dd><%= @inquiry.vessel_name.presence || "Not provided" %></dd></div>
      </dl>
      <div class="staff-enquiry-description mt-4">
        <%= simple_format(h(@inquiry.description), {}, sanitize: false) %>
      </div>
      <p class="staff-enquiry-note">This is the request exactly as the client sent it. It cannot be edited — add an internal note if something needs explaining.</p>
      <p class="staff-enquiry-note">Attachments cannot be sent through the website yet. If the client mentions documents, agree a secure way to receive them.</p>
    </section>

    <% if @duplicate_candidates.any? || @duplicates.any? %>
      <%= render "staff/service_inquiries/duplicates" %>
    <% end %>

    <%= render "staff/service_inquiries/clarifications" %>
    <%= render "staff/service_inquiries/quotations" %>
    <%= render "staff/service_inquiries/notes" %>
    <%= render "staff/service_inquiries/timeline" %>
  </div>
</div>

<div class="staff-editor-return">
  <%= link_to "Return to enquiries", staff_service_inquiries_path, class: "staff-editor-footer__return-link" %>
</div>
