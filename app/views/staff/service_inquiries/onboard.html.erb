<% content_for :staff_nav, :enquiries %>
<%= ant_page_header(
      title: "Set up client access",
      description: "Link this qualified enquiry to a client organisation and prepare a secure invitation. Commercial acceptance is not enabled in this release."
    ) %>

<section class="staff-quote-side-panel mt-6 max-w-3xl" aria-labelledby="onboard-heading">
  <%= render "shared/ui/side_panel_head", title: "Client access setup", heading_id: "onboard-heading", icon: "users" %>
  <div class="staff-quote-side-panel__body">
    <p class="staff-quote-versions__lede">Enquiry <%= @inquiry.reference_number %> · <%= @inquiry.company_name %> · <%= @inquiry.contact_email %></p>

    <%= form_with url: onboard_staff_service_inquiry_path(@inquiry), method: :post, scope: :onboarding, local: true, class: "mt-4 space-y-5" do |f| %>
      <fieldset>
        <legend class="text-[13px] font-medium text-[#173244]">1. Client organisation</legend>
        <label class="staff-enquiry-choice mt-2">
          <input type="radio" name="onboarding[organization_mode]" value="create" <%= "checked" if @form[:organization_mode] == "create" %> required>
          Create a new organisation
        </label>
        <label class="staff-enquiry-choice">
          <input type="radio" name="onboarding[organization_mode]" value="existing" <%= "checked" if @form[:organization_mode] == "existing" %>>
          Use an existing organisation
        </label>
        <div class="mt-3 space-y-3">
          <div class="ant-field ant-field--portal">
            <label class="ant-field__label" for="onboarding_organization_name">Organisation name</label>
            <input type="text" name="onboarding[organization_name]" id="onboarding_organization_name" value="<%= @form[:organization_name] %>" class="ant-control w-full">
          </div>
          <%= ant_select_tag "onboarding[client_organization_id]", @client_organizations.map { |o| [ o.name, o.id ] },
                             id: "onboarding_client_organization_id", label: "Existing organisation",
                             selected: @form[:client_organization_id], include_blank: "Choose organisation", searchable: true, compact: true %>
        </div>
        <% if @duplicates.any? %>
          <div class="staff-quote-notice staff-quote-notice--warn mt-3" role="status">
            <p class="font-semibold">Possible matches</p>
            <ul class="mt-2 list-disc pl-5 text-sm">
              <% @duplicates.each do |dup| %>
                <li><%= dup.name %><% if dup.reference_number.present? %> (<%= dup.reference_number %>)<% end %></li>
              <% end %>
            </ul>
            <p class="mt-2 text-sm">Confirm the correct organisation below. Nothing is linked automatically from matching names or emails.</p>
          </div>
        <% end %>
      </fieldset>

      <fieldset>
        <legend class="text-[13px] font-medium text-[#173244]">2. Client representative</legend>
        <div class="mt-3 space-y-3">
          <div class="ant-field ant-field--portal">
            <label class="ant-field__label" for="onboarding_contact_name">Contact name</label>
            <input type="text" name="onboarding[contact_name]" id="onboarding_contact_name" value="<%= @form[:contact_name] %>" class="ant-control w-full" required>
          </div>
          <div class="ant-field ant-field--portal">
            <label class="ant-field__label" for="onboarding_contact_email">Email for invitation</label>
            <input type="email" name="onboarding[contact_email]" id="onboarding_contact_email" value="<%= @form[:contact_email] %>" class="ant-control w-full" required>
          </div>
          <div class="ant-field ant-field--portal">
            <label class="ant-field__label" for="onboarding_contact_phone">Phone</label>
            <input type="text" name="onboarding[contact_phone]" id="onboarding_contact_phone" value="<%= @form[:contact_phone] %>" class="ant-control w-full">
          </div>
        </div>
        <p class="staff-quote-summary__hint mt-2">Corrections here update the invitation contact only. The original enquiry submission stays unchanged.</p>
      </fieldset>

      <fieldset>
        <legend class="text-[13px] font-medium text-[#173244]">3. Portal access</legend>
        <div class="mt-3">
          <%= ant_select_tag "onboarding[role_key]", client_portal_role_options(@allowed_roles),
                             id: "onboarding_role_key", label: "What can they do?",
                             selected: @form[:role_key], include_blank: "Choose access level", compact: true %>
        </div>
        <p class="staff-quote-summary__hint mt-2">Accepting or declining quotations is not available in this release, even if a role includes that permission in the catalogue.</p>
      </fieldset>

      <fieldset>
        <legend class="text-[13px] font-medium text-[#173244]">4. Review and invitation</legend>
        <label class="staff-enquiry-choice mt-3">
          <input type="checkbox" name="onboarding[confirm_organization]" value="1" required>
          I confirm this is the correct organisation for this enquiry.
        </label>
        <div class="ant-field ant-field--portal mt-3">
          <label class="ant-field__label" for="onboarding_link_reason">Confirmation note (optional)</label>
          <input type="text" name="onboarding[link_reason]" id="onboarding_link_reason" class="ant-control w-full" maxlength="200">
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-3">
        <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Prepare invitation</button>
        <%= ant_back_link label: "Cancel", path: staff_service_inquiry_path(@inquiry) %>
      </div>
    <% end %>
  </div>
</section>
