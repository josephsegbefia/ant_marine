<div class="grid gap-6 lg:grid-cols-[1fr_18rem]">
  <div class="space-y-6">
    <section class="staff-enquiry-panel p-5">
      <h2 class="staff-quote-editor__step-title">Project overview</h2>
      <dl class="staff-quote-summary mt-3">
        <div><dt>Reference</dt><dd><%= @project.reference_number %></dd></div>
        <div><dt>Client</dt><dd><%= @project.client_organization.name %></dd></div>
        <div><dt>Quotation</dt><dd><%= @project.quote.reference_number %> · Version <%= @project.quote_revision.version_number %></dd></div>
        <div><dt>Location</dt><dd><%= @project.location.presence || "—" %></dd></div>
        <div><dt>Vessel / asset</dt><dd><%= @project.vessel_name.presence || "—" %></dd></div>
        <div><dt>Coordinator</dt><dd><%= @project.coordinator_membership&.user&.full_name.presence || @project.coordinator_membership&.user&.email || "Not assigned" %></dd></div>
        <div><dt>Proposed start</dt><dd><%= @project.proposed_start_on ? l(@project.proposed_start_on) : "—" %></dd></div>
        <div><dt>Target completion</dt><dd><%= @project.target_completion_on ? l(@project.target_completion_on) : "—" %></dd></div>
      </dl>
      <% if @project.operational_description.present? %>
        <h3 class="mt-4 text-sm font-semibold">Operational description</h3>
        <div class="staff-quote-summary__hint mt-1"><%= simple_format(@project.operational_description) %></div>
      <% end %>
      <% if policy(@project).view_internal_notes? && @project.internal_notes.present? %>
        <h3 class="mt-4 text-sm font-semibold">Internal notes</h3>
        <div class="staff-quote-summary__hint mt-1"><%= simple_format(@project.internal_notes) %></div>
      <% end %>
    </section>

    <% if policy(@project).view_commercial? %>
      <section class="staff-enquiry-panel p-5">
        <h2 class="staff-quote-editor__step-title">Agreed commercial terms</h2>
        <p class="staff-quote-summary__hint mt-1">Read-only from the accepted offer. Editing here is not allowed.</p>
        <dl class="staff-quote-summary mt-3">
          <div><dt>Total</dt><dd><%= @project.commercial_snapshot["currency"] %> <%= format("%.2f", @project.commercial_snapshot["total_cents"].to_i / 100.0) %></dd></div>
          <div><dt>Scope</dt><dd><%= simple_format(@project.commercial_snapshot["scope_description"]) %></dd></div>
          <div><dt>Deliverables</dt><dd><%= simple_format(@project.commercial_snapshot["deliverables"]) %></dd></div>
        </dl>
      </section>
    <% end %>

    <% if staff_can_view_finance? && Billing::Access.can_manage?(Current.membership) %>
      <% currency = @project.commercial_snapshot["currency"] %>
      <% accepted = Billing::Capacity.accepted_total_cents(@project) %>
      <% issued = Billing::Capacity.issued_committed_cents(@project) %>
      <% remaining = Billing::Capacity.remaining_billable_cents(@project, include_drafts: true) %>
      <% issued_invoices = @project.invoices.issued %>
      <% paid = issued_invoices.sum(&:net_paid_cents) %>
      <% outstanding = issued_invoices.sum(&:outstanding_cents) %>
      <section class="staff-enquiry-panel p-5">
        <h2 class="staff-quote-editor__step-title">Simulated billing</h2>
        <p class="staff-quote-summary__hint mt-1">Not genuine receivables. Figures stay in the accepted currency only.</p>
        <dl class="staff-quote-summary mt-3">
          <div><dt>Accepted amount</dt><dd><%= currency %> <%= format("%.2f", accepted / 100.0) %></dd></div>
          <div><dt>Issued amount</dt><dd><%= currency %> <%= format("%.2f", issued / 100.0) %></dd></div>
          <div><dt>Recorded payments</dt><dd><%= currency %> <%= format("%.2f", paid / 100.0) %></dd></div>
          <div><dt>Outstanding</dt><dd><%= currency %> <%= format("%.2f", outstanding / 100.0) %></dd></div>
          <div><dt>Remaining billable</dt><dd><%= currency %> <%= format("%.2f", remaining / 100.0) %></dd></div>
        </dl>
        <% if remaining.positive? && !Rails.env.production? %>
          <div class="mt-4">
            <%= link_to "Create invoice", new_staff_invoice_path(project_id: @project.id), class: "ant-btn-outline ant-btn-outline--compact" %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="staff-quote-side-panel">
      <%= render "shared/ui/side_panel_head", title: "Next actions", heading_id: "project-actions", icon: "check" %>
      <div class="staff-quote-side-panel__body space-y-2">
        <% if policy(@project).transition? %>
          <% reason_actions = %i[place_on_hold cancel resume] %>
          <% (@actions - reason_actions).each do |action| %>
            <%= button_to action.to_s.tr("_", " ").humanize,
                  transition_staff_project_path(@project),
                  params: { project_action: action },
                  class: "ant-btn-outline ant-btn-outline--compact w-full",
                  form: { class: "w-full" } %>
          <% end %>

          <% if @actions.include?(:place_on_hold) %>
            <%= form_with url: transition_staff_project_path(@project), method: :post, class: "mt-3 space-y-2", local: true do %>
              <%= hidden_field_tag :project_action, "place_on_hold" %>
              <label class="ant-field__label" for="hold_reason">Put on hold — reason</label>
              <input id="hold_reason" name="reason" class="ant-control w-full" required>
              <button class="ant-btn-outline ant-btn-outline--compact w-full" type="submit">Place on hold</button>
            <% end %>
          <% end %>

          <% if @actions.include?(:resume) %>
            <%= form_with url: transition_staff_project_path(@project), method: :post, class: "mt-3 space-y-2", local: true do %>
              <%= hidden_field_tag :project_action, "resume" %>
              <label class="ant-field__label" for="resume_reason">Resume — reason</label>
              <input id="resume_reason" name="reason" class="ant-control w-full" required>
              <button class="ant-btn-outline ant-btn-outline--compact w-full" type="submit">Resume project</button>
            <% end %>
          <% end %>

          <% if @actions.include?(:cancel) %>
            <%= form_with url: transition_staff_project_path(@project), method: :post, class: "mt-3 space-y-2", local: true do %>
              <%= hidden_field_tag :project_action, "cancel" %>
              <label class="ant-field__label" for="cancel_reason">Cancel project — reason</label>
              <input id="cancel_reason" name="reason" class="ant-control w-full" required>
              <button class="ant-btn-outline ant-btn-outline--compact w-full" type="submit">Cancel project</button>
            <% end %>
          <% end %>

          <% if @actions.empty? %>
            <p class="staff-quote-summary__hint">No further status changes are available right now.</p>
          <% end %>
        <% else %>
          <p class="staff-quote-summary__hint">No further status changes are available right now.</p>
        <% end %>
        <% doc_count = policy_scope(Document).where(project_id: @project.id).not_archived.count %>
        <% if doc_count.positive? %>
          <p class="staff-quote-summary__hint mt-3"><%= doc_count %> document<%= doc_count == 1 ? "" : "s" %> on file.</p>
          <%= link_to "Open documents", staff_project_documents_path(@project), class: "staff-quote-link mt-2 inline-block" %>
        <% else %>
          <p class="staff-quote-summary__hint mt-3">No documents yet.</p>
          <% if policy(Document.new(project: @project)).create? %>
            <%= link_to "Upload or request files", staff_project_documents_path(@project), class: "staff-quote-link mt-2 inline-block" %>
          <% end %>
        <% end %>
      </div>
    </section>
  </aside>
</div>
