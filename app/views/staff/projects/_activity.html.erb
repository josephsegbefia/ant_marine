<section class="staff-enquiry-panel p-5">
  <h2 class="staff-quote-editor__step-title">Activity</h2>

  <% if policy(@project).publish_update? %>
    <%= form_with url: staff_project_updates_path(@project), method: :post, class: "mt-3 space-y-3", local: true do %>
      <div class="ant-field">
        <label class="ant-field__label" for="update_body">Project update</label>
        <textarea id="update_body" name="body" class="ant-control w-full" rows="3" required></textarea>
      </div>
      <div class="ant-field">
        <label class="ant-field__label" for="update_visibility">Visibility</label>
        <select id="update_visibility" name="visibility" class="ant-control w-full">
          <option value="client">Visible to client</option>
          <option value="internal">Internal only</option>
        </select>
      </div>
      <button type="submit" class="ant-btn-primary ant-btn-primary--compact">Publish update</button>
    <% end %>
  <% end %>

  <ol class="ant-timeline mt-6">
    <% @updates.each do |update| %>
      <li class="ant-timeline__item ant-timeline__item--note">
        <p class="ant-timeline__title"><%= update.client_visible? ? "Client update" : "Internal note" %></p>
        <p class="ant-timeline__detail"><%= simple_format(update.body) %></p>
        <p class="ant-timeline__meta"><%= update.author_membership.user.full_name.presence || update.author_membership.user.email %> · <%= l(update.published_at, format: :short) %></p>
      </li>
    <% end %>
    <% @status_events.each do |event| %>
      <li class="ant-timeline__item ant-timeline__item--status">
        <p class="ant-timeline__title">Status → <%= event.to_status.tr("_", " ").humanize %></p>
        <% if event.reason.present? %><p class="ant-timeline__detail"><%= event.reason %></p><% end %>
        <p class="ant-timeline__meta"><%= event.actor_membership.user.full_name.presence || event.actor_membership.user.email %> · <%= l(event.occurred_at, format: :short) %></p>
      </li>
    <% end %>
  </ol>
</section>
