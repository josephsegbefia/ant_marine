<% content_for :title, "Staff workspace — ANT Marine" %>

<div class="portal-shell max-w-xl">
  <header class="portal-head">
    <div>
      <h1>Staff workspace</h1>
      <p>
        Signed in as <%= Current.user.email %> ·
        <%= RoleLabels.label(Current.membership.role_key) %> ·
        <%= Current.membership.organization.name %>
      </p>
    </div>
  </header>

  <section class="portal-card">
    <p class="text-sm text-[#5f7d8c]">Manage team access and invitations from here.</p>
    <p class="mt-4">
      <%= link_to "Invitations", staff_invitations_path, class: "portal-btn-secondary" %>
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Switch workspace", workspace_selection_path, class: "portal-btn-secondary" %>
      <%= button_to "Sign out", session_path, method: :delete, class: "portal-btn-secondary", form: { class: "inline" } %>
    </div>
  </section>
</div>