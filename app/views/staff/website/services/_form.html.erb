<%= form_with model: [:staff, :website, service], class: "space-y-4" do |f| %>
  <% if service.errors.any? %>
    <div class="portal-card border-red-200 bg-red-50 text-sm text-red-900">
      <%= service.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="portal-card space-y-4">
    <%= f.label :title, class: "block text-sm font-semibold" %>
    <%= f.text_field :title, class: "ant-control w-full", required: true %>
    <%= f.label :slug, class: "block text-sm font-semibold" %>
    <%= f.text_field :slug, class: "ant-control w-full", required: true %>
    <%= f.label :summary, class: "block text-sm font-semibold" %>
    <%= f.text_area :summary, rows: 2, class: "ant-control w-full" %>
    <%= f.label :body, "Full explanation", class: "block text-sm font-semibold" %>
    <%= f.text_area :body, rows: 6, class: "ant-control w-full" %>
    <%= f.label :audience, class: "block text-sm font-semibold" %>
    <%= f.text_area :audience, rows: 2, class: "ant-control w-full" %>
    <%= f.label :scope_items_text, "Scope items (one per line)", class: "block text-sm font-semibold" %>
    <%= f.text_area :scope_items_text, value: service.scope_items&.join("\n"), rows: 6, class: "ant-control w-full font-mono text-sm" %>
    <%= f.label :process_steps_text, "Process notes (one per line)", class: "block text-sm font-semibold" %>
    <%= f.text_area :process_steps_text, value: service.process_steps&.join("\n"), rows: 4, class: "ant-control w-full font-mono text-sm" %>
    <%= f.label :display_order, class: "block text-sm font-semibold" %>
    <%= f.number_field :display_order, class: "ant-control w-full", min: 0 %>
    <%= f.label :seo_title, "SEO title", class: "block text-sm font-semibold" %>
    <%= f.text_field :seo_title, value: service.seo["title"], class: "ant-control w-full" %>
    <%= f.label :seo_description, "SEO description", class: "block text-sm font-semibold" %>
    <%= f.text_area :seo_description, value: service.seo["description"], rows: 2, class: "ant-control w-full" %>
  </div>

  <%= f.submit "Save draft", class: "ant-btn-primary ant-btn-primary--compact" %>
<% end %>