<% content_for :staff_nav, :website %>
<%= render "staff/website/header", title: @service.title, subtitle: public_content_status_label(@service.status) %>

<div class="mt-4 flex flex-wrap gap-2">
  <%= link_to "Open guided editor", edit_staff_website_service_path(@service), class: "ant-btn-primary ant-btn-primary--compact" %>
  <% if policy(@service).submit_for_review? && @service.draft? %>
    <%= button_to "Submit for review", submit_for_review_staff_website_service_path(@service), method: :post, class: "ant-btn-primary ant-btn-primary--compact" %>
  <% end %>
  <% if policy(@service).withdraw? && @service.in_review? %>
    <%= button_to "Withdraw", withdraw_staff_website_service_path(@service), method: :post, class: "ant-btn-outline ant-btn-primary--compact" %>
  <% end %>
  <% if policy(@service).approve? && @service.in_review? %>
    <%= button_to "Approve", approve_staff_website_service_path(@service), method: :post, class: "ant-btn-primary ant-btn-primary--compact" %>
  <% end %>
  <% if policy(@service).publish? && (@service.approved? || @service.published?) %>
    <%= button_to "Publish", publish_staff_website_service_path(@service), method: :post, class: "ant-btn-primary ant-btn-primary--compact" %>
  <% end %>
  <% if policy(@service).unpublish? && @service.published? %>
    <%= button_to "Unpublish", unpublish_staff_website_service_path(@service), method: :post, class: "ant-btn-outline ant-btn-primary--compact" %>
  <% end %>
  <% if policy(@service).archive? %>
    <%= button_to "Archive", archive_staff_website_service_path(@service), method: :post, form: { data: { turbo_confirm: "Archive this service?" } }, class: "ant-btn-outline ant-btn-primary--compact" %>
  <% end %>
</div>

<div class="portal-card mt-6 text-sm text-[#5f7d8c]">
  <p>Public preview is available only after publishing. Draft and in-review content never appears on the public website.</p>
</div>

<%= link_to "Back to services", staff_website_services_path, class: "mt-6 inline-block text-sm font-semibold text-[#25877f]" %>