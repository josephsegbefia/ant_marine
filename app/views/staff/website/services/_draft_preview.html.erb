<div class="staff-editor-preview" aria-live="polite" aria-atomic="false">
  <p class="staff-editor-preview__label">Draft preview</p>
  <p class="staff-editor-preview__note">This is how your draft may look after publishing. Visitors cannot see drafts.</p>
  <article class="staff-editor-preview__card">
    <p class="public-eyebrow">Our services</p>
    <h2 class="staff-editor-preview__title" data-staff-service-editor-target="previewTitle">Service title</h2>
    <p class="staff-editor-preview__summary" data-staff-service-editor-target="previewSummary">Short description</p>
    <h3 class="text-sm font-semibold text-[#102c43] mt-4">How we can help</h3>
    <p class="text-sm text-[#5f7d8c] mt-2" data-staff-service-editor-target="previewBody">Full explanation</p>
    <ul class="mt-3 space-y-1 text-sm text-[#466270] list-disc pl-5" data-staff-service-editor-target="previewScopeList"></ul>
    <h3 class="text-sm font-semibold text-[#102c43] mt-4">What happens next?</h3>
    <p class="text-sm text-[#5f7d8c] mt-2" data-staff-service-editor-target="previewProcess">Process steps</p>
    <h3 class="text-sm font-semibold text-[#102c43] mt-4">Who this service is for</h3>
    <p class="text-sm text-[#5f7d8c] mt-2" data-staff-service-editor-target="previewAudience">Intended audience</p>
  </article>
  <div class="staff-editor-preview__meta mt-4">
    <p class="text-xs text-[#5f7d8c]">Page address: <span data-staff-service-editor-target="previewUrl">/services/example</span></p>
    <div class="mt-3 rounded-lg border border-[#e2eaeb] bg-white p-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-[#5f7d8c]">Search preview</p>
      <p class="text-sm font-semibold text-[#1a0dab] mt-1" data-staff-service-editor-target="previewSeoTitle">Page title</p>
      <p class="text-xs text-[#006621]" data-staff-service-editor-target="previewUrl">antmarine.example/services</p>
      <p class="text-sm text-[#4d5156] mt-1" data-staff-service-editor-target="previewSeoDescription">Description preview</p>
    </div>
  </div>
</div>