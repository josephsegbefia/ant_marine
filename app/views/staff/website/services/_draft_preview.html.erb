<% preview_heading_id = local_assigns.fetch(:heading_id, "service-draft-preview-heading") %>
<section class="staff-quote-side-panel staff-editor-preview" aria-live="polite" aria-atomic="false" aria-labelledby="<%= preview_heading_id %>">
  <%= render "shared/ui/side_panel_head",
        title: "Draft preview",
        heading_id: preview_heading_id,
        icon: "compass" %>
  <div class="staff-quote-side-panel__body">
    <p class="staff-quote-versions__lede">This is how your draft may look after publishing. Visitors cannot see drafts.</p>
    <article class="staff-editor-preview__card">
      <p class="public-eyebrow">Our services</p>
      <h2 class="staff-editor-preview__title" data-staff-service-editor-target="previewTitle">Service title</h2>
      <p class="staff-editor-preview__summary" data-staff-service-editor-target="previewSummary">Short description</p>
      <h3 class="staff-editor-preview__section">How we can help</h3>
      <p class="staff-editor-preview__copy" data-staff-service-editor-target="previewBody">Full explanation</p>
      <ul class="staff-editor-preview__list" data-staff-service-editor-target="previewScopeList"></ul>
      <h3 class="staff-editor-preview__section">What happens next?</h3>
      <p class="staff-editor-preview__copy" data-staff-service-editor-target="previewProcess">Process steps</p>
      <h3 class="staff-editor-preview__section">Who this service is for</h3>
      <p class="staff-editor-preview__copy" data-staff-service-editor-target="previewAudience">Intended audience</p>
    </article>
    <div class="staff-editor-preview__meta">
      <p class="staff-quote-summary__hint">Page address: <span data-staff-service-editor-target="previewUrl">/services/example</span></p>
      <div class="staff-editor-preview__search">
        <p class="staff-quote-summary__next-label">Search preview</p>
        <p class="staff-editor-preview__search-title" data-staff-service-editor-target="previewSeoTitle">Page title</p>
        <p class="staff-editor-preview__search-url" data-staff-service-editor-target="previewUrl">antmarine.example/services</p>
        <p class="staff-editor-preview__search-desc" data-staff-service-editor-target="previewSeoDescription">Description preview</p>
      </div>
    </div>
  </div>
</section>
