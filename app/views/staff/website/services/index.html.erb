<% content_for :staff_nav, :website %>

<div class="staff-website-hub">
  <%= render "staff/website/management_header",
        active_tab: :services,
        primary_action: (policy(Service).create? ? { label: "Create service", path: new_staff_website_service_path } : nil) %>

  <% if @services.any? %>
    <%= render layout: "staff/website/content_list_panel",
              locals: {
                section_title: "Service pages",
                heading_id: "staff-website-services-list",
                notice: "Changes to public service descriptions should be reviewed before publishing."
              } do %>
      <% @services.each do |service| %>
        <%= ant_content_record(
              title: service.title,
              description: service_record_description(service),
              guidance: public_content_list_guidance(service.status),
              meta: service_record_meta(service),
              icon: service_record_icon(service),
              status_label: public_content_status_label(service.status),
              status_badge_class: public_content_status_badge_class(service.status),
              primary_action: service_list_primary_action(service),
              secondary_action: service_list_secondary_action(service)
            ) %>
      <% end %>
    <% end %>
  <% else %>
    <div class="staff-website-hub__empty">
      <%= ant_empty_state(
            icon: :layers,
            title: "No service pages yet",
            description: "Create a draft service page when you are ready to add to the public catalogue.",
            guidance: "Nothing is visible on the public website until a service is reviewed and published.",
            primary_action: (policy(Service).create? ? { label: "Create a service", path: new_staff_website_service_path } : nil),
            secondary_action: { label: "View website pages", path: staff_website_pages_path },
            variant: :default,
            size: :spacious
          ) %>
    </div>
  <% end %>
</div>