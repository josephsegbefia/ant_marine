<% content_for :staff_nav, :website %>
<% content_for :staff_page_title, "Website" %>
<%= staff_website_breadcrumb_trail(
      crumbs: [
        { label: "Website", path: staff_website_services_path }
      ],
      current: "Services"
    ) %>
<%= render "staff/website/header", title: "Service pages", subtitle: "Manage what visitors read about your services." %>

<% if @services.any? %>
  <% if policy(Service).create? %>
    <div class="mt-6 flex justify-end">
      <%= link_to "New service draft", new_staff_website_service_path, class: "ant-btn-primary ant-btn-primary--compact" %>
    </div>
  <% end %>
  <div class="mt-4 space-y-3">
    <% @services.each do |service| %>
      <%= link_to staff_website_service_path(service), class: "portal-card block hover:border-[#25877f]" do %>
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-base font-semibold text-[#102c43]"><%= service.title %></h2>
            <p class="text-sm text-[#5f7d8c]"><%= service.slug %> · <%= service.status.humanize %></p>
          </div>
          <span class="text-sm text-[#25877f]">Edit</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="mt-6">
    <%= ant_empty_state(
          icon: :layers,
          title: "No service pages yet",
          description: "Create a draft service page when you are ready to add to the public catalogue.",
          guidance: "Nothing is visible on the public website until a service is reviewed and published.",
          primary_action: (policy(Service).create? ? { label: "Create a service", path: new_staff_website_service_path } : nil),
          secondary_action: { label: "View website pages", path: staff_website_pages_path },
          variant: :default,
          size: :spacious
        ) %>
  </div>
<% end %>

<p class="mt-6 text-sm"><%= link_to "Website pages", staff_website_pages_path, class: "font-semibold text-[#25877f]" %></p>