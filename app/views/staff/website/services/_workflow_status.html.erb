<% if service.persisted? %>
  <section class="staff-quote-side-panel staff-editor-workflow" aria-labelledby="service-publishing-heading">
    <%= render "shared/ui/side_panel_head",
          title: "Publishing status",
          heading_id: "service-publishing-heading",
          icon: "globe",
          badge_label: public_content_status_label(service.status),
          badge_class: public_content_status_badge_class(service.status) %>
    <div class="staff-quote-side-panel__body">
      <p class="staff-quote-versions__lede"><%= service_status_guidance(service) %></p>
      <div class="mt-4">
        <%= render "staff/website/workflow_actions", record: service %>
      </div>
      <p class="staff-quote-summary__hint mt-3">Saving a draft does not publish. Someone with publish permission approves and publishes when content is ready.</p>
    </div>
  </section>
<% end %>
