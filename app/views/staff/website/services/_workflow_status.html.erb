<% if service.persisted? %>
  <div class="portal-card staff-editor-workflow">
    <h2 class="text-base font-semibold text-[#102c43]">Publishing status</h2>
    <p class="mt-2 text-sm text-[#5f7d8c]">
      <span class="font-semibold text-[#173244]"><%= public_content_status_label(service.status) %></span>
      — <%= service_status_guidance(service) %>
    </p>
  <div class="mt-4">
      <%= render "staff/website/workflow_actions", record: service %>
    </div>
    <p class="mt-3 text-xs text-[#5f7d8c]">Saving a draft does not publish. Someone with publish permission approves and publishes when content is ready.</p>
  </div>
<% end %>