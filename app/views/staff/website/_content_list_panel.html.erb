<%# locals: section_title (optional), heading_id (optional), notice (optional), icon (optional) %>
<% heading_id = local_assigns[:heading_id] || "content-list-heading" %>
<section class="staff-quote-side-panel ant-content-list" aria-labelledby="<%= heading_id %>">
  <% if local_assigns[:section_title].present? %>
    <%= render "shared/ui/side_panel_head",
          title: section_title,
          heading_id: heading_id,
          icon: local_assigns.fetch(:icon, "layers") %>
  <% end %>
  <div class="ant-content-list__items">
    <%= yield %>
  </div>
  <% if local_assigns[:notice].present? %>
    <p class="ant-content-list__notice"><%= notice %></p>
  <% end %>
</section>
