<%# locals: record:, back_label:, back_path:, guidance: (optional) %>
<% status_label = public_content_status_label(record.status) %>
<% guidance_text = local_assigns[:guidance] || public_content_list_guidance(record.status) %>

<div class="mt-6 max-w-3xl portal-card">
  <h2 class="text-base font-semibold text-[#102c43]">Editorial workflow</h2>
  <p class="mt-2 text-sm text-[#5f7d8c]">
    <span class="font-semibold text-[#173244]"><%= status_label %></span>
    — <%= guidance_text %>
  </p>
  <div class="mt-4">
    <%= render "staff/website/workflow_actions", record: record %>
  </div>
</div>

<div class="portal-card mt-6 max-w-3xl text-sm text-[#5f7d8c]">
  <p>Public preview is available only after publishing. Draft and in-review content never appears on the public website.</p>
</div>

<%= link_to back_label, back_path, class: "mt-6 inline-block text-sm font-semibold text-[#25877f]" %>