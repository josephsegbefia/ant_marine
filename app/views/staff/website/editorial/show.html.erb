<% content_for :staff_nav, :website %>
<%= render "staff/website/header", title: @record.title, subtitle: public_content_status_label(@record.status) %>

<% if policy(@record).update? %>
  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to "Continue editing", url_for(action: :edit, id: @record), class: "ant-btn-outline ant-btn-outline--compact" %>
  </div>
<% end %>

<%= render "staff/website/content_review",
      record: @record,
      back_label: "Back to #{editorial_section_label.downcase}",
      back_path: editorial_index_path %>