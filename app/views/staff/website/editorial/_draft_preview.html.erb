<section class="staff-quote-side-panel staff-editor-preview" aria-live="polite" aria-labelledby="legacy-editorial-draft-preview-heading">
  <%= render "shared/ui/side_panel_head",
        title: "Draft preview",
        heading_id: "legacy-editorial-draft-preview-heading",
        icon: "compass" %>
  <div class="staff-quote-side-panel__body">
    <p class="staff-quote-versions__lede">Matches public reading styles. Visitors never see drafts.</p>
    <article class="staff-editor-preview__card">
      <h2 class="staff-editor-preview__title" data-staff-editorial-preview-target="previewTitle">Title preview</h2>
      <p class="staff-editor-preview__summary" data-staff-editorial-preview-target="previewSummary">Short introduction</p>
      <div class="public-rich-text mt-3 text-sm text-[#466270]" data-staff-editorial-preview-target="previewBody">
        Main content preview
      </div>
    </article>
  </div>
</section>
