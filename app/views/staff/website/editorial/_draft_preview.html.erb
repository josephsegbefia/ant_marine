<div class="staff-editor-preview" aria-live="polite">
  <p class="staff-editor-preview__label">Draft preview</p>
  <p class="staff-editor-preview__note">Matches public reading styles. Visitors never see drafts.</p>
  <article class="staff-editor-preview__card">
    <h2 class="staff-editor-preview__title" data-staff-editorial-preview-target="previewTitle">Title preview</h2>
