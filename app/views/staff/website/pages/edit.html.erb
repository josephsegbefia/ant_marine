<% content_for :staff_nav, :website %>
<%= render "staff/website/header", title: "Edit page", subtitle: @page.page_key.humanize %>

<%= form_with model: @page, url: staff_website_page_path(@page), scope: :public_site_page, class: "mt-6 space-y-4" do |f| %>
  <% if @page.errors.any? %>
    <div class="portal-card border-red-200 bg-red-50 text-sm text-red-900">
      <%= @page.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="portal-card space-y-4">
    <%= f.label :title, class: "block text-sm font-semibold" %>
    <%= f.text_field :title, class: "ant-control w-full", required: true %>
    <%= f.label :summary, class: "block text-sm font-semibold" %>
    <%= f.text_area :summary, rows: 2, class: "ant-control w-full" %>
    <%= f.label :body, class: "block text-sm font-semibold" %>
    <%= f.text_area :body, rows: 8, class: "ant-control w-full" %>

    <% if @page.page_key == "homepage" %>
      <% data = @page.page_data %>
      <%= label_tag :eyebrow, "Hero eyebrow", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[eyebrow]", data["eyebrow"], class: "ant-control w-full" %>
      <%= label_tag :hero_title, "Hero title", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[hero_title]", data["title"] || data["hero_title"], class: "ant-control w-full" %>
      <%= label_tag :hero_lede, "Hero introduction", class: "block text-sm font-semibold" %>
      <%= text_area_tag "public_site_page[hero_lede]", data["lede"] || data["hero_lede"], rows: 3, class: "ant-control w-full" %>
      <%= label_tag :primary_cta_label, "Primary button label", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[primary_cta_label]", data["primary_cta_label"], class: "ant-control w-full" %>
      <%= label_tag :primary_cta_path, "Primary button path", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[primary_cta_path]", data["primary_cta_path"], class: "ant-control w-full" %>
      <%= label_tag :secondary_cta_label, "Secondary button label", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[secondary_cta_label]", data["secondary_cta_label"], class: "ant-control w-full" %>
      <%= label_tag :secondary_cta_path, "Secondary button path", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[secondary_cta_path]", data["secondary_cta_path"], class: "ant-control w-full" %>
    <% elsif @page.page_key == "contact" %>
      <% data = @page.page_data %>
      <%= label_tag :contact_email, "Email (approved only)", class: "block text-sm font-semibold" %>
      <%= email_field_tag "public_site_page[contact_email]", data["email"], class: "ant-control w-full" %>
      <%= label_tag :contact_phone, "Phone (approved only)", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[contact_phone]", data["phone"], class: "ant-control w-full" %>
      <%= label_tag :contact_address, "Address", class: "block text-sm font-semibold" %>
      <%= text_area_tag "public_site_page[contact_address]", data["address"], rows: 2, class: "ant-control w-full" %>
      <%= label_tag :contact_hours, "Opening hours", class: "block text-sm font-semibold" %>
      <%= text_field_tag "public_site_page[contact_hours]", data["hours"], class: "ant-control w-full" %>
    <% end %>

    <%= f.label :seo_title, "SEO title", class: "block text-sm font-semibold" %>
    <%= text_field_tag "public_site_page[seo_title]", @page.seo["title"], class: "ant-control w-full" %>
    <%= f.label :seo_description, "SEO description", class: "block text-sm font-semibold" %>
    <%= text_area_tag "public_site_page[seo_description]", @page.seo["description"], rows: 2, class: "ant-control w-full" %>
  </div>

  <%= f.submit "Save draft", class: "ant-btn-primary ant-btn-primary--compact" %>
<% end %>