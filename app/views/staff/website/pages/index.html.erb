<% content_for :staff_nav, :website %>
<% content_for :staff_page_title, "Website" %>
<%= staff_website_breadcrumb_trail(
      crumbs: [
        { label: "Website", path: staff_website_services_path }
      ],
      current: "Pages"
    ) %>
<%= render "staff/website/header", title: "Website content", subtitle: "Update public page sections and contact information." %>

<% if @pages.any? %>
  <div class="mt-6 space-y-3">
    <% @pages.each do |page| %>
      <%= link_to staff_website_page_path(page), class: "portal-card block hover:border-[#25877f]" do %>
        <h2 class="text-base font-semibold text-[#102c43]"><%= page.title %></h2>
        <p class="text-sm text-[#5f7d8c]"><%= page.page_key.humanize %> · <%= page.status.humanize %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="mt-6">
    <%= ant_empty_state(
          icon: :globe,
          title: "No website pages yet",
          description: "Homepage, about, industries and contact sections appear here once your team adds them.",
          guidance: "Use your organisation’s seed or import process to add the first page drafts.",
          secondary_action: { label: "View service pages", path: staff_website_services_path },
          variant: :muted,
          tone: :info
        ) %>
  </div>
<% end %>

<p class="mt-6 text-sm"><%= link_to "Service pages", staff_website_services_path, class: "font-semibold text-[#25877f]" %></p>