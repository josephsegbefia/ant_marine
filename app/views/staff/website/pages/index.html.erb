<% content_for :staff_nav, :website %>

<div class="staff-website-hub">
  <%= render "staff/website/management_header", active_tab: :pages %>

  <% if @pages.any? %>
    <%= render layout: "staff/website/content_list_panel",
              locals: {
                section_title: "Website sections",
                heading_id: "staff-website-pages-list",
                notice: "Draft changes only appear publicly after approval and publishing."
              } do %>
      <% @pages.each do |page| %>
        <%= ant_content_record(
              title: page.title,
              description: public_site_page_description(page),
              guidance: public_content_list_guidance(page.status),
              meta: (page.updated_at.present? ? "Last saved #{l(page.updated_at, format: :short)}" : nil),
              icon: :globe,
              status_label: public_content_status_label(page.status),
              status_badge_class: public_content_status_badge_class(page.status),
              primary_action: public_site_page_list_primary_action(page),
              secondary_action: public_site_page_list_secondary_action(page)
            ) %>
      <% end %>
    <% end %>
  <% else %>
    <div class="staff-website-hub__empty">
      <%= ant_empty_state(
            icon: :globe,
            title: "No website pages yet",
            description: "Homepage, about, industries and contact sections appear here once your team adds them.",
            guidance: "Use your organisation’s seed or import process to add the first page drafts.",
            secondary_action: { label: "View service pages", path: staff_website_services_path },
            variant: :muted,
            tone: :info
          ) %>
    </div>
  <% end %>
</div>