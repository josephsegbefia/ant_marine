<% content_for :staff_nav, :website %>
<%= render "staff/website/header", title: @page.title, subtitle: public_content_status_label(@page.status) %>

<div class="mt-6 flex flex-wrap gap-2">
  <%= link_to "Continue editing", edit_staff_website_page_path(@page), class: "ant-btn-outline ant-btn-outline--compact" %>
</div>

<div class="mt-6 max-w-3xl portal-card">
  <h2 class="text-base font-semibold text-[#102c43]">Editorial workflow</h2>
  <p class="mt-2 text-sm text-[#5f7d8c]"><%= public_content_list_guidance(@page.status) %></p>
  <div class="mt-4">
    <%= render "staff/website/workflow_actions", record: @page %>
  </div>
</div>

<%= link_to "Back to website pages", staff_website_pages_path, class: "mt-6 inline-block text-sm font-semibold text-[#25877f]" %>