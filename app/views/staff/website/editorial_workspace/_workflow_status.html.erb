<% if record.persisted? %>
  <section class="staff-quote-side-panel staff-editor-workflow" aria-labelledby="editorial-publishing-heading">
    <%= render "shared/ui/side_panel_head",
          title: "Publishing status",
          heading_id: "editorial-publishing-heading",
          icon: "globe",
          badge_label: public_content_status_label(record.status),
          badge_class: public_content_status_badge_class(record.status) %>
    <div class="staff-quote-side-panel__body">
      <p class="staff-quote-versions__lede"><%= public_content_list_guidance(record.status) %></p>
      <div class="mt-4">
        <%= render "staff/website/workflow_actions", record: record %>
      </div>
      <p class="staff-quote-summary__hint mt-3">Saving a draft does not publish. Someone with publish permission approves and publishes when content is ready.</p>
    </div>
  </section>
<% end %>
