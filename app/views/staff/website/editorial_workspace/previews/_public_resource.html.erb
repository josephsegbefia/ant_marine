<div class="staff-editor-preview" aria-live="polite">
  <p class="staff-editor-preview__label">Draft preview</p>
  <article class="staff-editor-preview__card">
    <p class="public-eyebrow"><%= config[:eyebrow] %></p>
    <h2 class="staff-editor-preview__title" data-staff-editorial-wizard-target="previewTitle">Resource title</h2>
    <p class="staff-editor-preview__summary" data-staff-editorial-wizard-target="previewSummary">Description</p>
    <div class="public-rich-text mt-3 text-sm" data-staff-editorial-wizard-target="previewBody"></div>
  </article>
</div>