<div class="staff-editor-preview" aria-live="polite">
  <p class="staff-editor-preview__label">Draft preview</p>
  <p class="staff-editor-preview__note">Project story preview — drafts stay private until published.</p>
  <article class="staff-editor-preview__card">
    <p class="public-eyebrow"><%= config[:eyebrow] %></p>
    <h2 class="staff-editor-preview__title" data-staff-editorial-wizard-target="previewTitle">Story title</h2>
    <p class="staff-editor-preview__summary" data-staff-editorial-wizard-target="previewSummary">Overview</p>
    <div class="public-rich-text mt-3 text-sm" data-staff-editorial-wizard-target="previewBody">Main narrative</div>
  </article>
  <p class="text-xs text-[#5f7d8c] mt-4">Page address: <span data-staff-editorial-wizard-target="previewUrl">/projects/example</span></p>
</div>