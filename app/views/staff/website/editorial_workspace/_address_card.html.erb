<% path = record.persisted? ? editorial_public_path(record) : nil %>
<% fixed_path = local_assigns[:fixed_path] %>
<div class="staff-editor-address">
  <p class="staff-editor-address__label">Page address</p>
  <% if path.present? %>
    <p class="staff-editor-address__path"><%= path %></p>
    <p class="staff-editor-address__hint">Set when this draft was first saved. It does not change if you edit the title.</p>
  <% elsif fixed_path.present? %>
    <p class="staff-editor-address__path"><%= fixed_path %></p>
    <p class="staff-editor-address__hint">This page has a fixed address on the public website.</p>
  <% else %>
    <p class="staff-editor-address__value" data-staff-editorial-wizard-target="suggestedPath">We will assign an address when you save this draft.</p>
    <p class="staff-editor-address__hint">Based on your title — you do not need to choose it yourself.</p>
  <% end %>
</div>
