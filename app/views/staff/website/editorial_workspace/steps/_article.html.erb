<section id="editor-step-panel-1" role="tabpanel" aria-labelledby="editor-step-tab-1" class="staff-editor-panel portal-card"
         data-step="1" data-staff-editorial-wizard-target="panel" data-validate="title:Enter an article title.|summary:Add a short introduction.|body:Add the main article content."
         <%= "hidden" unless editor_step == 1 %>>
  <h2 id="editor-step-heading-1" class="text-lg font-semibold text-[#102c43]" tabindex="-1">Write your article</h2>
  <p class="text-sm text-[#5f7d8c] mt-1">Give readers a clear title, introduction and main story.</p>
  <div class="mt-4 space-y-4">
    <%= ant_field form, :title, label: "Article title", required: true, context: :portal, html_options: { data: { staff_editorial_wizard_target: "titleField", action: "input->staff-editorial-wizard#titleInput" } } %>
    <%= ant_field form, :summary, type: :textarea, label: "Short introduction", required: true, context: :portal, html_options: { rows: 3 } %>
    <%= ant_rich_text_field form, :body, label: "Main content", required: true, hint: "Use headings and lists to help readers scan the article." %>
    <%= render "staff/website/editorial_workspace/address_card", record: record %>
  </div>
</section>

<section id="editor-step-panel-2" role="tabpanel" aria-labelledby="editor-step-tab-2" class="staff-editor-panel portal-card"
         data-step="2" data-staff-editorial-wizard-target="panel" data-validate="category:Choose a category."
         <%= "hidden" unless editor_step == 2 %>>
  <h2 id="editor-step-heading-2" class="text-lg font-semibold text-[#102c43]" tabindex="-1">Page details</h2>
  <p class="text-sm text-[#5f7d8c] mt-1">Choose how this article is grouped and how it may appear in search.</p>
  <div class="mt-4 space-y-4">
    <%= ant_select form, :category, choices: Article::CATEGORIES.map { |k, v| [v, k] }, label: "Category", context: :portal, placeholder: "Choose category" %>
    <details class="staff-editor-page-settings" open>
      <summary class="cursor-pointer text-sm font-semibold text-[#25877f]">Page settings</summary>
      <div class="mt-4 space-y-4">
        <div class="ant-field ant-field--portal">
          <label class="ant-field__label" for="<%= form.object_name %>_seo_title">Preferred search title</label>
          <%= text_field_tag "#{form.object_name}[seo_title]", record.seo["title"], class: "ant-control w-full", id: "#{form.object_name}_seo_title" %>
          <p class="ant-field__hint">Leave blank to use your article title.</p>
        </div>
        <div class="ant-field ant-field--portal">
          <label class="ant-field__label" for="<%= form.object_name %>_seo_description">Preferred search summary</label>
          <%= text_area_tag "#{form.object_name}[seo_description]", record.seo["description"], rows: 2, class: "ant-control w-full", id: "#{form.object_name}_seo_description" %>
        </div>
      </div>
    </details>
  </div>
</section>

<section id="editor-step-panel-3" role="tabpanel" aria-labelledby="editor-step-tab-3" class="staff-editor-panel portal-card"
         data-step="3" data-staff-editorial-wizard-target="panel" <%= "hidden" unless editor_step == 3 %>>
  <h2 id="editor-step-heading-3" class="text-lg font-semibold text-[#102c43]" tabindex="-1">Review</h2>
  <p class="text-sm text-[#5f7d8c] mt-1">Check content and status. Previewing is not publishing.</p>
  <div class="mt-4 portal-card bg-[#f6fafb] hidden" data-staff-editorial-wizard-target="missingPanel">
    <p class="text-sm font-semibold text-[#102c43]">Still needed:</p>
    <ul class="mt-2 list-disc pl-5 text-sm text-[#466270]" data-staff-editorial-wizard-target="missingList"></ul>
  </div>
  <div class="mt-6 lg:hidden">
    <%= render "staff/website/editorial_workspace/previews/article", record: record, config: editorial_workspace_config(record) %>
  </div>
</section>