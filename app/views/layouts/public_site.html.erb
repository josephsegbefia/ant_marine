<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if defined?(@seo_title) && @seo_title.present? %>
      <%= public_seo_tags(
            title: @seo_title,
            description: @seo_description,
            canonical: request.original_url.split("?").first
          ) %>
    <% else %>
      <title><%= content_for(:title) || "ANT Marine W.A." %></title>
    <% end %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="public-site-body">
    <div data-controller="public-nav">
      <%= render "shared/public/header" %>
      <main class="public-site-main" id="main-content">
        <%= yield %>
      </main>
      <%= render "shared/public/footer" %>
    </div>
  </body>
</html>