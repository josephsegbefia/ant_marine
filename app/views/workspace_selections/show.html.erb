<% content_for :title, "Choose your company — ANT Marine W.A." %>

<div class="login-page">
  <%= render "shared/auth_branded_panel", heading_id: "workspace-panel-heading" %>

  <div class="login-form-area">
    <div class="login-form login-form--wide">
      <h2>Choose your company.</h2>
      <p class="login-form__intro">Your account has access to more than one workspace.</p>

      <% if @memberships.empty? %>
        <p class="login-alert" role="status">No active workspace memberships are available on this account.</p>
      <% else %>
        <ul class="workspace-list" role="list">
          <% @memberships.each do |membership| %>
            <li class="workspace-item">
              <span class="workspace-icon" aria-hidden="true">
                <% if membership.organization.ant_marine? %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><path d="M2 21v-2a7 7 0 0 1 14 0v2M18 5a3 3 0 0 1 0 6m1 4a6 6 0 0 1 3 6"></path></svg>
                <% else %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"></rect><path d="M8 7V4h8v3M3 13h18"></path></svg>
                <% end %>
              </span>
              <div class="workspace-item__body">
                <div class="workspace-item__title"><%= membership.organization.name %></div>
                <div class="workspace-item__meta">
                  <%= membership.organization.ant_marine? ? "Staff workspace" : "Client workspace" %>
                </div>
              </div>
              <span class="ant-badge <%= membership.organization.ant_marine? ? "ant-badge--teal" : "ant-badge--blue" %>">
                <%= membership.organization.ant_marine? ? "Team" : "Client" %>
              </span>
              <%= button_to "Continue",
                    workspace_select_path,
                    method: :patch,
                    params: { membership_id: membership.id },
                    class: "ant-btn-primary ant-btn-primary--compact",
                    form: { class: "workspace-item__action" } %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <p class="login-form__hint">Only choose an account you’re authorised to use.</p>

      <div class="mt-6">
        <%= button_to "Sign out", session_path, method: :delete, class: "ant-text-link", form: { class: "inline" } %>
      </div>
    </div>
  </div>
</div>