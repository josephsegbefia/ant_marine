<% content_for :title, "Sign in — ANT Marine W.A." %>

<div class="login-page">
  <%= render "shared/auth_branded_panel", heading_id: "login-panel-heading" %>

  <div class="login-form-area">
    <div class="login-form">
      <h2>Welcome back.</h2>
      <p class="login-form__intro">Sign in to see your work with ANT Marine.</p>

      <%= form_with url: session_url,
            class: "contents",
            data: {
              controller: "form-submit",
              action: "turbo:submit-start->form-submit#busy turbo:submit-end->form-submit#idle turbo:submit-error->form-submit#idle",
              form_submit_loading_message_value: "Signing in..."
            } do |form| %>
        <%= ant_field form, :email,
              type: :email,
              label: "Work email",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "name@company.com",
              value: params[:email] %>
        <%= ant_field form, :password,
              type: :password,
              label: "Password",
              required: true,
              autocomplete: "current-password",
              placeholder: "Enter your password",
              maxlength: 72 %>

        <div class="mb-5 text-right">
          <%= link_to "Forgot password?", new_password_path, class: "ant-text-link" %>
        </div>

        <%= form.button type: "submit", class: "ant-btn-primary", data: { form_submit_target: "submit" } do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="10" width="14" height="12" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          Sign in
        <% end %>
      <% end %>

      <p class="login-form__invite">New here? Ask ANT Marine for an invitation to your company’s account.</p>
    </div>
  </div>
</div>