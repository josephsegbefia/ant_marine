<% content_for :title, "Accept invitation — ANT Marine W.A." %>

<div class="login-page">
  <%= render "shared/auth_branded_panel", heading_id: "invitation-panel-heading" %>

  <div class="login-form-area">
    <div class="login-form">
      <%= render "shared/auth_flash" %>

      <div class="icon-circle" style="margin-bottom: 20px" aria-hidden="true">
        <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </div>

      <h2>You&apos;ve been invited.</h2>
      <p class="login-form__intro">
        ANT Marine has invited you to join <strong><%= @invitation.organization.name %></strong>
        on <%= @portal_label %>.
      </p>

      <div class="notice" style="margin: 22px 0">
        Invitation for <strong><%= @invitation.email %></strong>.
      </div>

      <% if authenticated? && Current.user.email != @invitation.email %>
        <div class="login-alert" role="alert">
          <p>You are signed in as <%= Current.user.email %>. Sign out and continue with the invited email.</p>
        </div>
        <%= button_to "Sign out", session_path, method: :delete, class: "ant-btn-outline mt-4" %>
      <% else %>
        <%= button_to "Continue", invitation_continue_path(params[:token]), class: "ant-btn-primary" %>
      <% end %>
    </div>
  </div>
</div>