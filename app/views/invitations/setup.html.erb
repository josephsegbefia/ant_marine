<% content_for :title, "Set up your account — ANT Marine W.A." %>

<div class="login-page">
  <%= render "shared/auth_branded_panel", heading_id: "invitation-setup-heading" %>

  <div class="login-form-area">
    <div class="login-form">
      <% if @existing_user %>
        <h2>Join <%= @invitation.organization.name %>.</h2>
        <p class="login-form__intro">Confirm that you want to accept this invitation with your existing account.</p>
        <div class="notice" style="margin: 22px 0">
          Signed in as <strong><%= @invitation.email %></strong>.
        </div>
        <%= form_with url: invitation_setup_path(params[:token]), method: :post,
              class: "contents",
              data: {
                controller: "form-submit",
                action: "turbo:submit-start->form-submit#busy turbo:submit-end->form-submit#idle turbo:submit-error->form-submit#idle",
                form_submit_loading_message_value: "Accepting invitation..."
              } do |form| %>
          <%= form.button type: "submit", class: "ant-btn-primary", data: { form_submit_target: "submit" } do %>
            Accept invitation
          <% end %>
        <% end %>
      <% else %>
        <h2>Set up your account.</h2>
        <p class="login-form__intro">Choose a password to keep your project information safe.</p>

        <%= form_with url: invitation_setup_path(params[:token]), method: :post,
              class: "contents",
              data: {
                controller: "form-submit",
                action: "turbo:submit-start->form-submit#busy turbo:submit-end->form-submit#idle turbo:submit-error->form-submit#idle",
                form_submit_loading_message_value: "Creating your account..."
              } do |form| %>
          <%= ant_field form, :full_name,
                label: "Your name",
                required: true,
                autofocus: true,
                autocomplete: "name",
                placeholder: "Full name" %>
          <%= ant_field form, :email,
                type: :email,
                label: "Work email",
                disabled: true,
                value: @invitation.email,
                aria: { readonly: true } %>
          <%= ant_field form, :password,
                type: :password,
                label: "Password",
                required: true,
                autocomplete: "new-password",
                placeholder: "Choose a secure password",
                maxlength: 72 %>
          <%= ant_field form, :password_confirmation,
                type: :password,
                label: "Confirm password",
                required: true,
                autocomplete: "new-password",
                placeholder: "Enter password again",
                maxlength: 72 %>

          <%= form.button type: "submit", class: "ant-btn-primary", data: { form_submit_target: "submit" } do %>
            Continue
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>