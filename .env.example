# Copy to `.env.local` (gitignored) and adjust values for your machine only.
# Never commit `.env.local` or real credentials.

ANT_MARINE_DB_HOST=127.0.0.1
ANT_MARINE_DB_PORT=5433
ANT_MARINE_DB_USER=ant_marine_dev
# Must match POSTGRES_PASSWORD in compose.dev.yml (local dev only).
ANT_MARINE_DB_PASSWORD=local-only-change-me

# Mail stays local until a provider is approved. Do not put real SMTP passwords here.
# MAIL_FROM="ANT Marine W.A. <no-reply@example.com>"
# APP_HOST=example.com
# APP_PROTOCOL=https
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Secure storage (P3-A6). Do not commit real keys.
# STORAGE_ACTIVE_STORAGE_SERVICE=local_encrypted
# STORAGE_ENCRYPTION_KEY=
# STORAGE_ENCRYPTION_KEY_VERSION=1
# STORAGE_MAX_UPLOAD_BYTES=5242880
# STORAGE_SCAN_COMMAND=
# Solid Queue: use `async` on macOS dev to avoid fork+pg crashes; Linux deploy may use `fork`.
# SOLID_QUEUE_SUPERVISOR_MODE=async
#
# Optional PoC integrations (not required for CI):
# S3 PoC (SeaweedFS — docker compose -f compose.seaweedfs-poc.yml up -d; scripts/s3_poc_bootstrap.sh):
# S3_POC_ENABLED=1
# S3_POC_ENDPOINT=http://127.0.0.1:8333
# Legacy alias: MINIO_POC_ENABLED=1 still honored by integration tests.
# CLAMAV_POC_ENABLED=1
# CLAMAV_POC_SCAN_COMMAND=scripts/clamav_local_scan.sh
# Host setup: brew install clamav; cp freshclam.conf.sample → freshclam.conf; freshclam
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION=eu-central
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true
