# Copy to `.env.local` (gitignored) and adjust values for your machine only.
# Never commit `.env.local` or real credentials.

ANT_MARINE_DB_HOST=127.0.0.1
ANT_MARINE_DB_PORT=5433
ANT_MARINE_DB_USER=ant_marine_dev
# Must match POSTGRES_PASSWORD in compose.dev.yml (local dev only).
ANT_MARINE_DB_PASSWORD=local-only-change-me

