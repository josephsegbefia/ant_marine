#!/usr/bin/env sh

# Foreman children need DB credentials before Rails boots (see docs/PHASE_PROGRESS.md).
if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env.local
  set +a
elif [ -z "${ANT_MARINE_DB_PASSWORD:-}" ]; then
  echo "Missing ANT_MARINE_DB_PASSWORD. Copy .env.example to .env.local and source it, or export the variable." >&2
  exit 1
fi

# Avoid macOS /usr/bin/bundle (system Ruby 2.6); use the project Ruby from mise when available.
if command -v mise >/dev/null 2>&1 && [ -z "${ANT_MARINE_BIN_DEV_MISE:-}" ]; then
  export ANT_MARINE_BIN_DEV_MISE=1
  exec mise exec -- "$0" "$@"
fi

if ! bundle show foreman >/dev/null 2>&1; then
  echo "Installing gems (including foreman)..." >&2
  bundle check || bundle install
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec bundle exec foreman start -f Procfile.dev "$@"